<!DOCTYPE html>
<html>
<head>
    <% include ../common/header %>
    <style>
        section {
            margin-top: 108px;
        }
        .title2 {
        font-size: 3rem;
        text-align: center;
        color: #6055cb;
        font-weight: bold;
        margin-top: 20px;
        margin-bottom: 20px;
    }
    p {
        display: block;
        margin-block-start: 1em;
        margin-block-end: 1em;
        margin-inline-start: 0px;
        margin-inline-end: 0px;
    }
    .subtitle {
        text-align: center;
        color: #6055CB;
        font-style: italic;
        font-size: 1.1rem;
        margin-top: 10px;
    }
    iframe {
        border: solid 2px #FF9A43;
        margin: 30px;
    }
    </style>
</head>
<body>
    <section>
        <div class="top_title">
            <h2 class="title2"><%= __('main_interact_1') %></h2>
        </div>
        <p class="subtitle"><%= __('main_interact_2') %></p>
        <div align="center">
            <a href="#" onclick="callSignUp();">
                <div style="text-decoration:none;display:block;color:#ffffff;background-color:#FF9A43;border-radius:4px;-webkit-border-radius:4px;-moz-border-radius:4px;width:40%; width:calc(40% - 2px);;border-top:1px solid #FF9A43;border-right:1px solid #FF9A43;border-bottom:1px solid #FF9A43;border-left:1px solid #FF9A43;padding-top:5px;padding-bottom:05px;font-family:Arial, Helvetica Neue, Helvetica, sans-serif;text-align:center;mso-border-alt:none;word-break:keep-all;">
                    <span style="font-size:16px;display:inline-block;"></span>
                        <span style="font-size: 16px; line-height: 2; word-break: break-word; mso-line-height-alt: 32px;"><%= __('main_interact_3') %></span>
                    </span>
                </div>
            </a>
        </div>
        <div align="center">
            <iframe width="80%" height="490px" src="/static/javascripts/interact.html"></iframe>
        </div>
        <div style="margin-left: 10px; margin-right: 10px;margin-bottom: 17.5px;">
            <%= __('main_interact_4') %>
        </div>
        <div align="center" style="padding-top: 10px;">
            <a href="#" onclick="callSignUp();">
                <div style="text-decoration:none;display:block;color:#ffffff;background-color:#FF9A43;border-radius:4px;-webkit-border-radius:4px;-moz-border-radius:4px;width:40%; width:calc(40% - 2px);;border-top:1px solid #FF9A43;border-right:1px solid #FF9A43;border-bottom:1px solid #FF9A43;border-left:1px solid #FF9A43;padding-top:5px;padding-bottom:05px;font-family:Arial, Helvetica Neue, Helvetica, sans-serif;text-align:center;mso-border-alt:none;word-break:keep-all;">
                    <span style="font-size:16px;display:inline-block;"></span>
                        <span style="font-size: 16px; line-height: 2; word-break: break-word; mso-line-height-alt: 32px;"><%= __('main_interact_5') %></span>
                    </span>
                </div>
            </a>
        </div>
        <div class="main_box2">
            <div class="box2_01">
                <img src="/static/images/img03.png">
            </div>
            <div class="box2_02" style="vertical-align: top">
                <div class="con_box">
                    <table>
                        <thead>
                            <tr>
                                <th colspan="2">
                                    <img src="/static/images/icon_user.png">
                                    <%= __('main_interact_6') %>
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <th><%= __('main_interact_7') %></th>
                                <td id="td1"><%= __('main_interact_8') %></td>
                            </tr>
                            <tr>
                                <th>
                                    <%= __('main_interact_9') %>
                                </th>
                                <td id="td2">
                                    <p><%= __('main_interact_10') %></p>
                                    <p><%= __('main_interact_11') %><br><%= __('main_interact_12') %></p>
                                    <p></p>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <div class="prim_box">
                    <table>
                        <thead>
                            <tr>
                                <th colspan="2">
                                    <img src="/static/images/icon_premium.png">
                                    <%= __('main_interact_13') %>
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <th><%= __('main_interact_14') %></th>
                                <td><%= __('main_interact_15') %><br><%= __('main_interact_16') %></td>
                            </tr>
                            <tr>
                                <th>
                                    <%= __('main_interact_17') %>
                                </th>
                                <td>
                                    <p><%= __('main_interact_18') %></p>
                                    <p><%= __('main_interact_19') %><br><%= __('main_interact_20') %></p>
                                    <p><%= __('main_interact_21') %><br><%= __('main_interact_22') %></p>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <div class="fam_box">
                    <table>
                        <thead>
                            <tr>
                                <th colspan="2">
                                    <img src="/static/images/icon_family.png">
                                    <%= __('main_interact_23') %>
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <th><%= __('main_interact_24') %> </th>
                                <td><%= __('main_interact_25') %><br><%= __('main_interact_26') %></td>
                            </tr>
                            <tr>
                                <th><%= __('main_interact_27') %> </th>
                                <td>
                                    <p><%= __('main_interact_28') %></p>
                                    <p><%= __('main_interact_29') %><br><%= __('main_interact_30') %></p>
                                    <p><%= __('main_interact_31') %><br><%= __('main_interact_32') %></p>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <div class="cautions_box">
                    <p class="title"><%= __('main_interact_33') %></p>
        
                    <p><span class="bold"><%= __('main_interact_34') %></span> <%= __('main_interact_35') %> <br>
                        <span class="bold"><%= __('main_interact_36') %></span> <%= __('main_interact_37') %> <br>
                        <%= __('main_interact_38') %> <b class="color_p"><%= __('main_interact_39') %></b>
                </div>
            </div>
        </div>
        <div align="center" style="padding-top: 10px;">
            <a href="#" onclick="callSignUp();">
                <div style="text-decoration:none;display:block;color:#ffffff;background-color:#FF9A43;border-radius:4px;-webkit-border-radius:4px;-moz-border-radius:4px;width:40%; width:calc(40% - 2px);;border-top:1px solid #FF9A43;border-right:1px solid #FF9A43;border-bottom:1px solid #FF9A43;border-left:1px solid #FF9A43;padding-top:5px;padding-bottom:05px;font-family:Arial, Helvetica Neue, Helvetica, sans-serif;text-align:center;mso-border-alt:none;word-break:keep-all;">
                    <span style="font-size:16px;display:inline-block;"></span>
                        <span style="font-size: 16px; line-height: 2; word-break: break-word; mso-line-height-alt: 32px;"><%= __('main_interact_40') %></span>
                    </span>
                </div>
            </a>
        </div>
    </section>
    <footer>
        <script src="/static/javascripts/hoola.js"></script>
        <% if(env == 'prod') { %>
        <!-- Global site tag (gtag.js) - Google Analytics -->
        <script async src="https://www.googletagmanager.com/gtag/js?id=UA-163897752-1"></script>
        <script>
            window.dataLayer = window.dataLayer || [];
            function gtag(){dataLayer.push(arguments);}
            gtag('js', new Date());
            gtag('config', 'UA-163897752-1');
        </script>
        <% } %>
        <script>
            function callSignUp() {
                <% if(env == 'prod') { %>
                gtag('event','click', {'event_catagory':'simulate', 'event_label':'event sign up'});
                <% } %>
                location.href = "/signup";
            }
        </script>
    </footer>
</body>
</html>