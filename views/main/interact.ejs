<!DOCTYPE html>
<html>
<head>
    <% include ../common/header %>
    <style>
        section {
            margin-top: 108px;
        }
        .title2 {
        font-size: 3rem;
        text-align: center;
        color: #6055cb;
        font-weight: bold;
        margin-top: 20px;
        margin-bottom: 20px;
    }
    p {
        display: block;
        margin-block-start: 1em;
        margin-block-end: 1em;
        margin-inline-start: 0px;
        margin-inline-end: 0px;
    }
    .subtitle {
        text-align: center;
        color: #6055CB;
        font-style: italic;
        font-size: 1.1rem;
        margin-top: 10px;
    }
    iframe {
        border: solid 2px #FF9A43;
        margin: 30px;
    }
    </style>
</head>
<body>
<% include ../common/googletag %>
    <section>
        <div class="top_title">
            <h2 class="title2">What is hoolamoolah?</h2>
        </div>
        <p class="subtitle">hoolamoolah is a global online top-up service started to minimize the hassle of inefficient trips and, at the same time, to enrich the lives of foreign workers and their families around the world.</p>
        <div align="center">
            <a href="#" onclick="callSignUp();">
                <div style="text-decoration:none;display:block;color:#ffffff;background-color:#FF9A43;border-radius:4px;-webkit-border-radius:4px;-moz-border-radius:4px;width:40%; width:calc(40% - 2px);;border-top:1px solid #FF9A43;border-right:1px solid #FF9A43;border-bottom:1px solid #FF9A43;border-left:1px solid #FF9A43;padding-top:5px;padding-bottom:05px;font-family:Arial, Helvetica Neue, Helvetica, sans-serif;text-align:center;mso-border-alt:none;word-break:keep-all;">
                    <span style="font-size:16px;display:inline-block;"></span>
                        <span style="font-size: 16px; line-height: 2; word-break: break-word; mso-line-height-alt: 32px;">SIGN UP NOW</span>
                    </span>
                </div>
            </a>
        </div>
        <div align="center">
            <iframe width="80%" height="490px" src="https://d1uvpyasv6rv5d.cloudfront.net/javascripts/interact.html"></iframe>
        </div>
        <div style="margin-left: 10px; margin-right: 10px;margin-bottom: 17.5px;">
            hoolamoolah is the fastest way to generate a secondary income which requires no hard work. The core concept of hoolamoolah is sharing the profit we make from your daily expenses. We currently provide a top-up service for most of the carriers worldwide and give back a portion of your use in HM Dollar, which can be used to utilize hoolamoolah’s current and upcoming services. Moreover, by introducing hoolamoolah to your families, friends, and colleagues, you can get extra HM Dollar.
        </div>
        <div align="center" style="padding-top: 10px;">
            <a href="#" onclick="callSignUp();">
                <div style="text-decoration:none;display:block;color:#ffffff;background-color:#FF9A43;border-radius:4px;-webkit-border-radius:4px;-moz-border-radius:4px;width:40%; width:calc(40% - 2px);;border-top:1px solid #FF9A43;border-right:1px solid #FF9A43;border-bottom:1px solid #FF9A43;border-left:1px solid #FF9A43;padding-top:5px;padding-bottom:05px;font-family:Arial, Helvetica Neue, Helvetica, sans-serif;text-align:center;mso-border-alt:none;word-break:keep-all;">
                    <span style="font-size:16px;display:inline-block;"></span>
                        <span style="font-size: 16px; line-height: 2; word-break: break-word; mso-line-height-alt: 32px;">SIGN UP NOW</span>
                    </span>
                </div>
            </a>
        </div>
        <div class="main_box2">
            <div class="box2_01">
                <img src="https://d1uvpyasv6rv5d.cloudfront.net/images/img03.png">
            </div>
            <div class="box2_02" style="vertical-align: top">
                <div class="con_box">
                    <table>
                        <thead>
                            <tr>
                                <th colspan="2">
                                    <img src="https://d1uvpyasv6rv5d.cloudfront.net/images/icon_user.png">
                                    Consumer
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <th>Requirements</th>
                                <td id="td1">None</td>
                            </tr>
                            <tr>
                                <th>
                                    Payback
                                </th>
                                <td id="td2">
                                    <p>3% in Total</p>
                                    <p>3% of Purchase Amount<br>on Tier 1 Customers</p>
                                    <p></p>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <div class="prim_box">
                    <table>
                        <thead>
                            <tr>
                                <th colspan="2">
                                    <img src="https://d1uvpyasv6rv5d.cloudfront.net/images/icon_premium.png">
                                    Premium
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <th>Requirements</th>
                                <td>Minimum monthly<br>spending over $50</td>
                            </tr>
                            <tr>
                                <th>
                                    Payback
                                </th>
                                <td>
                                    <p>10% in Total</p>
                                    <p>9% of Purchase Amount<br>on Tier 1 Customers</p>
                                    <p>1% of Purchase Amount on<br>Tier 2 Customers</p>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <div class="fam_box">
                    <table>
                        <thead>
                            <tr>
                                <th colspan="2">
                                    <img src="https://d1uvpyasv6rv5d.cloudfront.net/images/icon_family.png">
                                    Family
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <th>Requirements </th>
                                <td>Minimum monthly<br>spending over $20</td>
                            </tr>
                            <tr>
                                <th>Payback </th>
                                <td>
                                    <p>6% in Total</p>
                                    <p>5% of Purchase Amount<br>on Tier 1 Customers</p>
                                    <p>1% of Purchase Amount on<br>Tier 2 Customers</p>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <div class="cautions_box">
                    <p class="title">Note</p>
        
                    <p><span class="bold">*Tier 1</span> means Direct Customers <br>
                        <span class="bold">*Tier 2</span> means Direct customers of Tier 1 customer <br>
                        The monthly spending will be reset on the <b class="color_p">1st day of each month.</b>
                </div>
            </div>
        </div>
        <div align="center" style="padding-top: 10px;">
            <a href="#" onclick="callSignUp();">
                <div style="text-decoration:none;display:block;color:#ffffff;background-color:#FF9A43;border-radius:4px;-webkit-border-radius:4px;-moz-border-radius:4px;width:40%; width:calc(40% - 2px);;border-top:1px solid #FF9A43;border-right:1px solid #FF9A43;border-bottom:1px solid #FF9A43;border-left:1px solid #FF9A43;padding-top:5px;padding-bottom:05px;font-family:Arial, Helvetica Neue, Helvetica, sans-serif;text-align:center;mso-border-alt:none;word-break:keep-all;">
                    <span style="font-size:16px;display:inline-block;"></span>
                        <span style="font-size: 16px; line-height: 2; word-break: break-word; mso-line-height-alt: 32px;">SIGN UP NOW</span>
                    </span>
                </div>
            </a>
        </div>
    </section>
    <footer>
        <script src="https://d1uvpyasv6rv5d.cloudfront.net/javascripts/hoola.js"></script>
        <% if(env == 'prod') { %>
        <!-- Global site tag (gtag.js) - Google Analytics -->
        <script async src="https://www.googletagmanager.com/gtag/js?id=UA-163897752-1"></script>
        <script>
            window.dataLayer = window.dataLayer || [];
            function gtag(){dataLayer.push(arguments);}
            gtag('js', new Date());
            gtag('config', 'UA-163897752-1');
        </script>
        <% } %>
        <script>
            function callSignUp() {
                <% if(env == 'prod') { %>
                gtag('event','click', {'event_catagory':'simulate', 'event_label':'event sign up'});
                <% } %>
                location.href = "/signup";
            }
        </script>
    </footer>
</body>
</html>