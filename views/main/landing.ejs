<!DOCTYPE html>
<html>
<head>
    <% include ../common/header %>
</head>
<body>
    <header>
        <% include ../common/navigator %>
    </header>
    <div class="big_line2"></div>
    <section>
        <div class="top_img">
            <div class="top_img2">
                <img src="/static/images/img16.png">
            </div>
        </div>
        <div class="top_title">
        <h2 class="title2">hoolamoolah!</h2>
            <h1 class="title">The Unique Rewardable Top-up Service</h1>
            <h3 class="title3">Send phone credit to your loved ones or to yourself <br>
            with hoolamoolah's unique rewardable mobile recharging system</h3>
            
            </div>
        
        <div class="select_st2">
            <form class="form" action= "/order" method="POST" id="submit-form">
                <input id="marker" value="+" disabled>
                <input type="text" id="phoneId" name="phone" placeholder="Enter the Number to Top-up" width="40%">
                <button id="btnSubmit">Select Plan</button>
            </form>
        </div>
        <div class="icon_wrap2">
            <ul class="icon_box">
                <li>
                    <a href="#a"><span class="blind">Enter recipient number</span></a>
                    <p>Enter recipient <br>number</p>
                </li>
                <li>
                    <a href="#a"><span class="blind">Top-up to recharge</span></a>
                    <p>Top-up <br>to recharge</p>
                </li>
                <li>
                    <a href="#a"><span class="blind">Get Reward</span></a>
                    <p class="color_p">Get Reward<br>&nbsp;</p>
                </li>
            </ul>

          
        </div>
        
        <div class="big_line3"></div>
        <div class="conts_wrap" style="">
            <div class="dots2"><p>·</p><p>·</p><p>·</p><p>·</p><p>·</p></div>
            <p class="font_big">How To Make Extra Income</p>
        
            <div class="main_box">
                <div class="main_txt">
                    <p>Refer Your Friends</p>
                    <p>Give them HM 2$,</p>
                    HM dollar has a par value with US Dollar
                    <p>Get up to</p>
                    <p>10% Payback</p>
                </div>
                <div class="main_img">
                    <b><img src="/static/images/img18.png"></b>
                    <span><img src="/static/images/img17.png"></span>

                </div>

            </div>
                     
                <div class="main_box2">
                    <div class="box2_01">
                        <img src="/static/images/img03.png">
                    </div>
                    <div class="box2_02" style="vertical-align: top">
                        <div class="prim_box">
                            <table>
                                <thead>
                                    <tr>
                                        <th colspan="2">
                                            <img src="/static/images/icon_premium.png">
                                            Premium
                                        </th>
                                    </tr>                                    
                                </thead>
                                <tbody>
                                    <tr>
                                        <th>Requirements</th>
                                        <td>Minimum monthly<br>spending over $50</td>
                                    </tr>
                                    <tr>
                                        <th>
                                            Payback
                                        </th>
                                        <td>
                                            <p>10% in Total</p>
                                            <p>9% of Purchase Amount<br>on First Tier Customers</p>
                                            <p>1% of Purchase Amount on<br>Second Tier Customers</p>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                        <div class="fam_box">
                            <table>
                                <thead>
                                    <tr>
                                        <th colspan="2">
                                            <img src="/static/images/icon_family.png">
                                            Family
                                        </th>
                                    </tr>                                    
                                </thead>
                                <tbody>
                                    <tr>
                                        <th>Requirements </th>
                                        <td>Minimum monthly<br>spending over $20</td>
                                    </tr>
                                    <tr>
                                        <th>Payback </th>
                                        <td>
                                            <p>6% in Total</p>
                                            <p>5% of Purchase Amount<br>on First Tier Customers</p>
                                            <p>1% of Purchase Amount on<br>Second Tier Customers</p>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                        <div class="cautions_box">
                            <p class="title">Note</p>
                            
                            <p><span class="bold">*Tier 1</span> means Direct Customers <br>
                            <span class="bold">*Tier 2</span> means Direct customers of Tier 1 customer <br>
                            The monthly spending will be reset on the <b class="color_p">1st day of each month.</b>
                        </div>
                    </div>
                    <div class="ftst_wrap">
                <div class="ftst_box01">Commission Depending on Consumption Level</div>
                <div class="ftst_box02">
                    <span class="ft_box">
                        <span>First Tier</span>
                        <span><b class="firTier">9%</b></span>
                        <span><b class="firTier2">5%</b></span>
                    </span>
                    <span class="st_box">
                        <span class="color_o">Second Tier</span>
                        <span><b class="secTier">1%</b></span>
                    </span>
                </div>
            </div>
        </div>
            <div class="nbgo_wrap">
                <div class="nbgo_box1">
                    <p class="txtA">Top-up in over 140<br> Countries</p>
                    <p class="txtB">Sign-Up in 30 Seconds</p>
                    <p class="txtC">Sound Interesting? Check out how!</p>
                    <button class="signup_btn" onclick="gotoRegist()">Sign up</button>
                </div>
                <div class="nbgo_box2">
                    <p><img src="/static/images/icon_clock.png"></p>
                    <p>
                    <span><img src="/static/images/icon_mobile.png"></span>
                    <span><img src="/static/images/icon_coins.png"></span>
                    </p>
                </div>
            </div>
        </div>
    </section>
    <footer>
        <% include ../common/footers %>
    </footer>
    <script>
        // AOS.init({
        //     easing: 'ease-out-back',
        //     duration: 3000
        // });
        function gotoRegist() {
            location.href='/signup';
        }
        function closePop() {
            $('#earlyPop').css("display", 'none');
        }
    </script>
</body>
</html>