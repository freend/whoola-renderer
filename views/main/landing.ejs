<!DOCTYPE html>
<html>
<head>
    <% include ../common/header %>
    <link rel="stylesheet" type="text/css" href="/static/stylesheets/aos.css">
    <script src="/static/javascripts/aos.js"></script>
</head>
<body>
    <% include ../common/navigator %>
    <div class="big_line" data-aos="zoom-in"></div>
    <div class="dots"><p>·</p><p>·</p><p>·</p></div>
    <section>
        <h1 class="title">Network Based Global online <br>Top-up Platform</h1>
        <div class="icon_wrap">
            <ul class="icon_left">
                <li><a href="#a"><span class="blind">mobile</span></a></li>
                <li><a href="#a"><span class="blind">internet</span></a></li>
                <li><a href="#a"><span class="blind">television</span></a></li>
                <li><a href="#a"><span class="blind">telephone</span></a></li>
            </ul>
                <div class="select_st">
                    <label for="select01" class="blind">Select</label>
                    <select name="select01" id="select01">
                        <option value="1">Sign up</option>
                        <option value="2">Log in</option>
                        <option value="3">Account</option>
                    </select>
                    <button onclick="selectMenu()">Go</button>
                </div>
          
            <ul class="icon_right">
                <li><a href="#a"><span class="blind">gift card</span></a></li>
                <li><a href="#a"><span class="blind">utilities</span></a></li>
                <li><a href="#a"><span class="blind">VolP</span></a></li>
                <li><a href="#a"><span class="blind">more</span></a></li>
            </ul>
        </div>
        <div class="conts_wrap" style="">
            <div class="nbgo_wrap">
                <div class="nbgo_box1" data-aos="fade-up">
                    <p class="txtA">Easy Top-up<br>Sign-Up in 30<br> Seconds</p>
                    <p class="txtB">Sound Interesting? Check out how!</p>
                    <button onclick="gotoHow()">How to Use</button>
                </div>
                <div class="nbgo_box2" data-aos="fade-up">
                    <p><img src="/static/images/icon_clock.png"></p>
                    <p>
                    <span><img src="/static/images/icon_mobile.png"></span>
                    <span><img src="/static/images/icon_coins.png"></span>
                    </p>
                </div>
            </div>
            <div class="nbgo_wrap">
                    
                <div class="nbgo_box3" data-aos="fade-up">
                    <p class="txtA">3 Step Profit <br>Sharing</p>
                    <p class="txtB">See how much you can earn after logging in.</p>
                    <button onclick="location.href='/signup'">Sign up</button>
                </div>
                <div class="nbgo_box4" data-aos="fade-up">
                     <p><img src="/static/images/img07.png"></p>
                </div>
            </div>
            <div class="conts_pop" style="display: block" id="earlyPop">
                <div class="pop_wrap_main" style="">
                    <h1>HoolaMoolah Early-Bird Benefits</h1>
                    <p>1) Spend $20/Month to qualify as a business and gain 6% commission on sales (Tier1: 5%, Tier2: 1%)</p>
                    <p>2) Spend $50/Month to qualify as a business and gain 10% commission on sales (Tier1: 9%, Tier2: 1%)</p>
                    <p>3) $2 Bonus if you enter a referral code on registration <br>
                        (This bonus can only be used if the monthly spending is over $20. To withdraw, a minimum of 10 HM Dollar must be withdrawn)
                    </p>
                    <p>4) Business qualifications can be obtained if Business qualification products are purchased.</p>
                    <p>Pre-occupy the market faster than other Business Partners<br>
                        The above Early-Bird benefits may end early. This will be announced on hoolamoolah’s medium blog.<br>
                        hoolamoolah will always try our best for our family and businesses
                    </p>
                  <div class="btn_group">
                    <button class="btn_submit" onClick="closePop()">Close</button>
                  </div>
                </div>
              </div>
            
            <div class="mid_conts">
                <div class="mid_logo web"  data-aos="zoom-in">
                    <!--<img src="/static/images/logo_l.png">-->
                </div>
                <div class="mid_logo mobile"  data-aos="zoom-in">
                    <p>
                       Roadmap
                    </p>
                </div>
           
            
                <div class="txt_box" data-aos="fade-up">
                    In 2020, you will be able to use your HM Dollar to watch YouTube and network on Facebook. Furthermore, HoolaMoolah plans to partner with famous e-commerce services and we will never stop there, HM Dollar will be accepted when you use delivery services, when you pay at convenience stores and all the possible services you use in your everyday life.
                </div>
                
            </div>
            
            <div class="history">
                <div data-aos="fade-up" data-aos-delay="100">
                    <p><img src="/static/images/icon_i.png"></p>
                    <p>2020</p> 
                    <p> 
                        Launch Hoola Moolah<br><br>
                        Launch YouTube, Facebook product<br><br>
                        Initiate HM Cares Foundation (Charity, year-end)
                    </p>
                </div>
                <div data-aos="fade-up" data-aos-delay="200">
                    <p><img src="/static/images/icon_n.png"></p>
                    <p>2021</p> 
                    <p> 
                        Partner with e-commerce service providers<br><br>
                        Build 10 HM Cares Library (location TBA)
                    </p>
                </div>
                <div data-aos="fade-up" data-aos-delay="300">
                    <p><img src="/static/images/icon_n.png"></p>
                    <p>2022</p> 
                    <p> 
                        Build 10 HM Cares Library (location TBA)<br><br>
                        Build 10 HM Cares Schools (location TBA)
                    </p>
                </div>
                <div data-aos="fade-up" data-aos-delay="400">
                    <p><img src="/static/images/icon_n.png"></p>
                    <p>2023+</p> 
                    <p> 
                        Partner with delivery services, convenience stores<br><br>
                        Build 10 HM Cares Library (location TBA)<br><br>
                        Build 10 HM Cares Schools (location TBA)<br><br>
                        Build 10 HM Cares Town (location TBA)
                    </p>
                </div>
            </div>
        </div>
    </section>
    <footer>
        <% include ../common/footers %>
    </footer>
    <script>
        AOS.init({
            easing: 'ease-out-back',
            duration: 3000
        });
        function gotoHow() {
            window.open("about:blank").location.href='https://medium.com/hoolamoolah/how-to-use-hoolamoolah-fbbc7c117cd2';
        }
        function selectMenu() {
            const item = $('#select01').val();
            switch (item) {
                case "1":
                    location.href='/signup';
                break;
                case "2":
                    location.href='/login';
                break;
                case "3":
                    location.href='/users/info?token=' + localStorage.getItem('token');
                break;
            }
        }
        function closePop() {
            $('#earlyPop').css("display", 'none');
        }
    </script>
</body>
</html>