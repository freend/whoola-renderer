<!doctype html>
<html lang="ko">
<head>
    <% include ../common/header-2 %>
</head>
<body>
<% include ../common/googletag %>
<div id="wrap">
    <div id="fullpage">
        <div class="section fp-auto-height">
            <header>
                <% include ../common/navigator-2 %>
                <script src="/static/javascripts/validate.js"></script>
            </header>
            <div class="visual">
                <div class="wrapper">
                    <ul>
                        <li class="img01">The Best Top-Up Offer</li>
                        <li class="img02">The Best Top-Up Offer</li>
                        <li class="img03">The Best Top-Up Offer</li>
                    </ul>
                    <p class="txt" style="text-align: left">
                        <strong>The Best Top-Up Offer</strong>
                        <span>You Can Find!</span>
                    </p>
                </div>
            </div>
            <div class="selectplan">
                <div class="wrapper">
                    <h3><strong>Send Top-up to Loved Ones in Minutes</strong></h3>
                    <form>
                        <!-- start country code -->
                        <% include ../common/country %>
                        <!-- end country code -->
                        <div class="phone">
                            <input type="tel" placeholder="Your Mobile Number" id="phoneId"/>
                        </div>
                        <input type="button" value="Select Plan" id="btnSubmit"/>
                    </form>
                    <em>The phone number provided will be treated confidentially and in accordance with our privacy policy.</em>
                </div>
            </div>
        </div>
        <div class="section fp-auto-height">
            <div class="stories">
                <h3><strong>Stories from Our Customers</strong></h3>
                <ul class="txt_slide">
                    <li>
                        <div class="txt">
                            <strong>hoolamoolah is a must-have service if you live in another country. I was able to top-up my sister’s phone when she needed it the most. Thank you!</strong>
                            <p>Veronica, Cuba</p>
                        </div>
                    </li>
                    <li>
                        <div class="txt">
                            <strong>I live in the States and my family is in Philippines. We live so far away, yet we use the same service, hoolamoolah, for credit our phones. HM dollar system rocks!</strong>
                            <p>Andre, U.S.A</p>
                        </div>
                    </li>
                    <li>
                        <div class="txt">
                            <strong>"I top up my children's cell phones in the Philippines<br>through hoolamoolah. I am very satisfied."</strong>
                            <p>Vincent, United Arab Emirates</p>
                        </div>
                    </li>
                    <li>
                        <div class="txt">
                            <strong>“I like the payback service. So I introduce it to my family, friends, and colleagues.<br>When I receive payback, I want to give it to my parents.”</strong>
                            <p>Prasanna, India</p>
                        </div>
                    </li>
                    <li>
                        <div class="txt">
                            <strong>“Hoolamoolah lets me to top up whenever I need to.<br>I am super satisfied with your simple and fast top-up service.”</strong>
                            <p>Joseph, Canada</p>
                        </div>
                    </li>
                </ul>
                <div class="sub">
                    <strong>We want to know how you feel about hoolamoolah.</strong>
                    <p>Send us your stories to support@hoolamoolah.com and <em>get HM$10</em></p>
                </div>
            </div>
        </div>
        <div class="section fp-auto-height">
            <div class="payback">
                <div class="wrapper">
                    <div class="top">
                        <h3><strong>Get 10%<br>Payback</strong></h3>
                        <ul>
                            <li><em>8%</em> from Tier 1</li>
                            <li><em>2%</em> from Tier 2</li>
                        </ul>
                        <p>Minimum monthly spending</p>
                        <p>over $20 required to use HM$</p>
                        <a href="#" onClick="moreLink()" class="more">Learn More</a>
                    </div>
                </div>
            </div>
        </div>
        <div class="section fp-auto-height hm_wrap">
            <div class="pay_hm">
                <div class="pay_hm_wrap">
                    <div class="tit">
                        <p>HM Fund is</p>
                        <strong>Accountable, <br>Trustworthy, <br>Transparent</strong>
                    </div>
                    <div class="circle_wrap">
                        <div class="sub_wrap">
                            <div>
                                <div class="chart_wrap first">
                                    <div class="chart_circle">
                                        <div class="mask chart_full">
                                            <div class="fill loaded"></div>
                                        </div>
                                        <div class="mask chart_half">
                                            <div class="fill loaded"></div>
                                        </div>
                                        <div class="icon">
                                            <i><img src="/static/images/ico/ico_bill_wave.png" alt=""></i>
                                        </div>
                                    </div>
                                </div>
                                <div class="module_tit">
                                    <h3>HM$ 48,000</h3>
                                    <p>Remaining</p>
                                </div>
                            </div>
                            <div>
                                <div class="chart_wrap last">
                                    <div class="chart_circle">
                                        <div class="mask chart_full">
                                            <div class="fill loaded"></div>
                                        </div>
                                        <div class="mask chart_half">
                                            <div class="fill loaded"></div>
                                        </div>
                                        <div class="icon">
                                            <i><img src="/static/images/ico/ico_bill.png" alt=""></i>
                                        </div>
                                    </div>
                                </div>
                                <div class="module_tit">
                                    <h3>HM$ 6,000</h3>
                                    <p>Outstanding</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="section fp-auto-height">
            <div class="refer">
                <div class="wrapper">
                    <p class="img"><img src="/static/images/pic/pic_refer.jpg" alt="Refer to Your Friends Give HM$2 to Them"></p>
                    <div class="tit">
                        <h3><strong>Refer<br>Your Friends<br>Give HM$2 to Them</strong></h3>
                        <span>HM dollar has a par value with US Dollar.</span>
                        <a href="#" onClick="moreLink()" class="more">Learn More</a>
                    </div>
                </div>
            </div>
        </div>
        <div class="section fp-auto-height">
            <div class="signup">
                <div class="wrapper">
                    <h3><strong>We Have What You Need</strong></h3>
                    <div class="txt">
                        <p>Top-up for Over 140 Countries</p>
                        <a href="#" onclick="location.href='/signup'">Sign Up Now</a>
                    </div>
                </div>
            </div>
        </div>
        <div class="section fp-auto-height">
            <div class="secure">
                <div class="wrapper">
                    <h3><strong>hoolamoolah is Safe and Secure</strong></h3>
                    <ul>
                        <li>
                            <p></p>
                            <div class="sub">
                                <strong>Our Security</strong>
                                <p>
                                    <span>hoolamoolah puts protecting your</span>
                                    <span>money and your data on top of</span>
                                    <span>everything. Your security is Our security.</span>
                                </p>
                            </div>
                        </li>
                        <li>
                            <p></p>
                            <div class="sub">
                                <strong>Protect You From Fraud</strong>
                                <p>
                                    <span>hoolamoolah is using PayPal as a</span>
                                    <span>primary payment solution which will</span>
                                    <span>keep your money both safe and encrypted.</span>
                                </p>
                            </div>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
        <footer class="section fp-auto-height">
            <% include ../common/footers%>
        </footer>
        <br>
        <br>
        <br>
        <br>
        <br>
        <br>
        <br>
        <br>
        <br>
        <br>
        <br>
    </div>
</div>
</body>
</html>
<script>
    $('#btnSubmit').click(function() {
        <% if(env == 'prod') { %>
        gtag('event','click', {'event_catagory':'topup', 'event_label':'landing'});
        <% } %>
        const value = $(".num").text().split("+")[1] + $('#phoneId').val();
        console.log('value', value);
        if (!validatePhone(value)) {
            alert('Invalid Phone Number');
            return false;
        }
        location.href = '/order/topup?phoneNumber=' + value + '&token=' + localStorage.getItem('token');
        // console.log('phoneId', $('#phoneId').val(), 'token', localStorage.getItem('token'));
    });
    function moreLink() {
        const token = localStorage.getItem('token');
        if (token != null) {
            location.href = '/invite?page=1&token=' + token;
        } else {
            location.href='/login';
        }
    }
</script>