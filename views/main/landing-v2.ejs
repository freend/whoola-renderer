                console.log('marker click');
            }
        );
        function gotoRegist() {
            location.href='/signup';
        }
        function closePop() {
            $('#earlyPop').css("display", 'none');
        }
        function selectMenu() {
            const item = $('#select01').val();
            switch (item) {
                case "1":
                    location.href='/signup';
                break;
                case "2":
                    location.href='/login';
                break;
                case "3":
                    location.href='/users/info?token=' + localStorage.getItem('token');
                break;
            }
        }
        // $(".num").text().split("+")[1]; -- 번호 선택시 국가번호 뽑는 쿼리.
        $('#btnSubmit').click(function() {
            <% if(env == 'prod') { %>
                gtag('event','click', {'event_catagory':'topup', 'event_label':'landing'});
            <% } %>
            const value = '+' + $(".num").text().split("+")[1] + $('#phoneId').val();
            console.log('select value', value);
            if (!validatePhone($('#phoneId').val())) {
                alert('Invalid Phone Number');
                return false;
            }
            location.href = '/order/topup?phoneNumber=' + value + '&token=' + localStorage.getItem('token');
            // console.log('phoneId', $('#phoneId').val(), 'token', localStorage.getItem('token'));
        });
    </script>
