<script>
    window.onload = function() {
        var myToken = "<%= token%>";
        console.log("token : " + myToken);
        if(myToken != null) {
            myStorage = window.localStorage;
            localStorage.setItem('token', myToken);
        }
        var getMessage = "<%= message%>";
        if (getMessage != null) {
            alert(getMessage);
        }
        var redirectUrl = "<%= ahref%>";
        if (redirectUrl != null) {
            location.href = redirectUrl;
        }
    }
</script>