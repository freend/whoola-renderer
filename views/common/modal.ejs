<script>
    window.onload = function() {
        var myToken = localStorage.getItem('token');
        if(myToken != null) {
            myStorage = window.localStorage;
            localStorage.setItem('token', myToken);
        }
        var getMessage = "<%= message%>";
        if (getMessage != null) {
            alert(getMessage);
        }
        var redirectUrl = "<%= ahref%>";
        if (localStorage.getItem('token') == null && redirectUrl == '/purchase?page=1') {
            redirectUrl = null;
        }
        
        if (redirectUrl != null) {
            if (redirectUrl == '/order' || redirectUrl == '/users/info' || redirectUrl == '/service') {
                location.href = redirectUrl + "?token=" + localStorage.getItem('token');
            } else {
                location.href = redirectUrl + "&token=" + localStorage.getItem('token');
            }
        } else {
            location.href = '/purchase/success';
        }
    }
</script>