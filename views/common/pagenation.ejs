<% var defNum = Math.floor((page.pageable.pageNumber + 10) / 10) - 1;
         var startNum = (defNum * 10) + 1;
         var endNum = (defNum * 10) + 10;
         if (endNum > page.totalPages) {
            endNum = page.totalPages;
         }
         endNum = Math.min(page.totalElements, endNum);
      %>
 <br>
<nav aria-label="Page navigation example">
  <ul class="pagination">
    <li class = "page-item <% if(defNum == 0) { %>
        disabled
        <% } %>
    ">
      <a class="page-link" href="<%= url%>?page=<%= startNum - 10 %>" aria-label="Previous">
        <span aria-hidden="true">&laquo;</span>
      </a>
    </li>
        <% for (var i = startNum; i <= endNum; i++) {
                if(page.pageable.pageNumber + 1 == i) { %>
                <li class="page-item active"><a class="page-link" href="#" onClick="pageController(<%= i %>)"><%= i %><span class="sr-only">(current)</span></a></li>
            <% } else { %>
                <li class="page-item"><a class="page-link" href="#" onClick="pageController(<%= i %>)"><%= i %></a></li>
        <%  }
         } %>
    <li  class = "page-item <% if(defNum == Math.ceil(page.totalPages / 10) - 1) { %>
        disabled
        <% } %>
    ">
      <a class="page-link" href="<%= url%>?page=<%= startNum + 10 %>" aria-label="Next">
        <span aria-hidden="true">&raquo;</span>
      </a>
    </li>
  </ul>
</nav>
<script>
    function pageController(pageNum) {
        location.href = '<%= url %>' + '?page='+ pageNum + '&token=' + localStorage.getItem('token');
    }
</script>