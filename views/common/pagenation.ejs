<% var defNum = Math.floor((page.pageable.pageNumber + 10) / 10) - 1;
         var startNum = (defNum * 10) + 1;
         var endNum = (defNum * 10) + 10;
         if (endNum > page.totalPages) {
            endNum = page.totalPages;
         }
         endNum = Math.min(page.totalElements, endNum);
      %>
 <br>
start number : <%= startNum %>, end number : <%= endNum %>
<nav>
  <ul class="pagination">
    <li <% if(defNum == 0) { %>
        class="disabled"
        <% } %>
    >
      <a href="<%= url%>?page=<%= startNum - 10 %>" aria-label="Previous">
        <span aria-hidden="true">&laquo;</span>
      </a>
    </li>
        <% for (var i = startNum; i <= endNum; i++) {
                if(page.pageable.pageNumber + 1 == i) { %>
                <li class="active"><a href="#" onClick="pageController(<%= i %>)"><%= i %></a></li>
            <% } else { %>
                <li><a href="#" onClick="pageController(<%= i %>)"><%= i %></a></li>
        <%  }
         } %>
    <li <% if(defNum == Math.ceil(page.totalPages / 10) - 1) { %>
        class="disabled"
        <% } %>
    >
      <a href="<%= url%>?page=<%= startNum + 10 %>" aria-label="Next">
        <span aria-hidden="true">&raquo;</span>
      </a>
    </li>
  </ul>
</nav>
<script>
    function pageController(pageNum) {
    alert('page ' + pageNum + ', url ' + '<%= url %>');
        location.href = '<%= url %>' + '?page='+ pageNum + '&token=' + localStorage.getItem('token');
    }
</script>