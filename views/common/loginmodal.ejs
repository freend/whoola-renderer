<script>
    window.onload = function() {
        window.localStorage.setItem('token', "<%= token %>");
        var getMessage = "<%= message%>";
        if (getMessage != null) {
            alert(getMessage);
        }
        var redirectUrl = "<%= ahref%>";
        const productId = "<%= productId %>";
        if(productId != "") {
            redirectUrl += "/detail?productId=<%= productId %>&receiver=<%= phoneNumber %>&token=" + localStorage.getItem('token');
            location.href = redirectUrl;
        }
        else {
            location.href = redirectUrl + "?token=" + localStorage.getItem('token');
        }
    }
</script>