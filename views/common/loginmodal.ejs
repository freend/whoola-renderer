<script>
    window.onload = function() {
        window.localStorage.setItem('token', "<%= token %>");
        var getMessage = "<%= message%>";
        if (getMessage != null) {
            alert(getMessage);
        }
        var redirectUrl = "<%= ahref%>";
        redirectUrl = redirectUrl.replace(/&amp;/g, '&');
        location.href = redirectUrl + localStorage.getItem('token');
    }
</script>