    <script>
        function logout() {
            localStorage.removeItem('token');
            location.href = "/";
        }
        function setToken(value) {
            location.href = value + localStorage.getItem('token');
        }
        $(document).ready(function(){
            const haveToken = localStorage.getItem('token');
            var isLogin = '';
            var isLogout = '';

            if (haveToken != null) {
                isLogin = 'none';
                isLogout = 'inline';
            } else {
                isLogin = 'inline';
                isLogout = 'none';
            }
            $('#isLogout').css("display", isLogin);
            $('#isLogin').css("display", isLogout);
        });
    </script>