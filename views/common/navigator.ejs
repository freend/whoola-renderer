                        <button class="on" onclick="location.href='/signup'">Register</button>
                        <button onclick="location.href='/login'">Log in</button>
                    </div>
                    <div class="header_btn" id="isLogin">
                        <div class="mypage_open">
                            <h2>My Page <i class="a"></i></h2>
