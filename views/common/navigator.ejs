    <div class="head_wrap">
        <div class="logo"><a href="/"><img src="/static/images/logo.png" alt=""></a></div>
        <button class="btn_hamburger"><img src="/static/images/hamburger.png" alt=""></button>
        <div class="gnb_wrap">
            <ul class="gnb">
                <li><a href="#" onClick="setToken('/order?token=')"><%= __('common_navigator_1') %></a></li>
                <li><a href="#" onClick="setToken('/business?token=')"><%= __('common_navigator_2') %></a></li>
                <li><a href="#" onClick="setToken('/service?token=')"><%= __('common_navigator_3') %></a></li>
                <li><a href="#" onClick="setToken('/withdraw?token=')"><%= __('common_navigator_4') %></a></li>
                <li><a href="#" onClick="setToken('/invite?page=1&token=')"><%= __('common_navigator_5') %></a></li>
                <li>
                    <div class="header_btn" id="isLogout">
                        <button class="on" onclick="location.href='/signup'"><%= __('common_navigator_6') %></button>
                        <button onclick="location.href='/login'"><%= __('common_navigator_7') %></button>
                    </div>
                    <div class="header_btn" id="isLogin">
                        <div class="mypage_open">
                            <h2><%= __('common_navigator_8') %> <i class="a"></i></h2>
                            <ul class="mypage_menu">
                                <li><a href="#" onClick="setToken('/users/info?token=')"><%= __('common_navigator_9') %></a></li>
                                <li><a href="#" onClick="setToken('/purchase?page=1&token=')"><%= __('common_navigator_10') %></a></li>
                                <li><a href="#" onClick="setToken('/withdraw/list?page=1&token=')"><%= __('common_navigator_11') %></a></li>
                                <li><a href="#" onClick="setToken('/point?page=1&token=')"><%= __('common_navigator_12') %></a></li>
                                <li><a href="#" onClick="setToken('/tree?token=')"><%= __('common_navigator_13') %></a></li>
                            </ul>
                        </div>
                        <button onclick="logout();return false;"><%= __('common_navigator_14') %></button>
                    </div>
                </li>
            </ul>
        </div>
    </div>
    <script>
        function logout() {
            localStorage.removeItem('token');
            location.href = "/";
        }
        function setToken(value) {
            location.href = value + localStorage.getItem('token');
        }
        $(document).ready(function(){
            const haveToken = localStorage.getItem('token');
            var isLogin = '';
            var isLogout = '';

            if (haveToken != null) {
                isLogin = 'none';
                isLogout = 'inline';
            } else {
                isLogin = 'inline';
                isLogout = 'none';
            }
            $('#isLogout').css("display", isLogin);
            $('#isLogin').css("display", isLogout);
        });
    </script>