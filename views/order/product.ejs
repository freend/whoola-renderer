                <% for (var i = 0; i < list.length; i++) { %>
                <div class="purchase_box">
                    <div class="purchase_txt">
                        <p><span>USD</span><b><%= list[i].salesAmount %></b></p>
                        <p><span><%= list[i].name %></span></p>
                    </div>
                    <div class="purchase_btn">
                        <button onClick="buyDetail(<%= list[i].id %>)">Buy</button>
                    </div>
                </div>
                <% } %>
            </div>
        </div>
    </section>
