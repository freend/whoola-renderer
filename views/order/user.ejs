<!DOCTYPE html>
<html>
<head>
    <% include ../common/header %>
    <script src="/static/javascripts/validate.js"></script>
</head>
<body>
    <header>
        <% include ../common/navigator %>
        <div class="head_bar">
            <a href="https://medium.com/hoolamoolah/4-simple-steps-to-enjoy-hoolamoolah-aa04f15d7c39" target="_blank"><img src="/static/images/icon_02.png">how to use hoolamoolah</a>
            <a href="#" onClick="closedView()" class="close">X</a>
        </div>
    </header>
    <section>
        <h1 class="title">
            <% if(phone == null) { %>
            <span class="blind"><b>Step1</b> Number</span>
            Purchase Step
                <% if(category == 'order') { %>
                    <span><b>Step2 </b>Select Plan</span>
                <% } else {%>
                    <span><b>Step2 </b>Select Service</span>
                <% } %>
            <% }%>
        </h1>
        <h2 class="sub_title">
            <% if(phone == null) { %>
                Add Receive Phone number
                <% if(token != "null") { %>
                    , Or Select Below List
                <% } %>
            <% } else { %>
                Update User Name And Phone Number
            <% } %>
        </h2>
        <div class="conts_wrap">
            <div class="userinfo_wrap">
                <form class="form" 
                <% if (id == null) { 
                    if (category == "order") {%>
                    >
                    <% } else { %>
                    action="/service" method="POST" id="submit-form">
                    <% } %>
                <% } else { %>
                    action="/receiver/edit" method="POST" id="submit-form">
                <% } %>
                <input type="hidden" value="<%= token %>" id="token" name="token">
                <div class="input_box">
                    <h3>Phone Number</h3>
                    <div>+<input style="width: 92%;" type="number" id="phoneId" name="phone"
                        <% if(phone == null) { %>
                            placeholder="Enter the Number to Top-up"
                        <% } else { %>
                            value = "<%=phone %>"
                        <% } %>
                    ></div>
                    <small style="color: red;">Please check if the recipient phone number and mobile carrier match.</small><br>
                    <small><label id="match"></label></small>
                </div>
                <% if(token != "null" && name != null) { %>
                <div class="input_box">
                    <h3>Name</h3>
                    <div><input type="text" class="form-control" id="nameId" name="name"
                        <% if(name == null) { %>
                            placeholder="Insert Receiver Name"
                        <% } else { %>
                            value="<%= name %>"
                        <% } %>
                            >
                    </div>
                    <% if(id != null) { %>
                        <input type="hidden" name="id" id="id" value="<%=id %>">
                    <% } %>
                </div>
                <% } %>
                <% if (id == null) { %>
                </form>
                <% } %>
                <div class="btn_group btn_normal">
                    <button id="btnSubmit">
                        <% if(id == null) { 
                            if (category == 'topup') {%>
                            Select Topup
                            <% } else { %>
                                Select Service
                            <% } %>
                        <% } else { %>
                            Edit
                        <% } %>
                        </button>
                </div>
                <% if (id != null) { %>
                </form>
                <% } %>
                <% if (id == null && token != "null") { %>
                <div class="purchase_tbl mt_50">
                        <% include receiver %>
                </div>
                <% } %>
            </div>
        </div>
    </section>
    <script>
        const category = '<%= category%>';
        $('#btnSubmit').click(function(event){
            if (!validatePhone($('#phoneId').val())) {
                alert('Invalid Phone Number');
                return false;
            }
            if (category == '') {
                $('#submit-form').submit();
            } else {
                const value = $('#phoneId').val();
                var urls = (category == 'topup') ? '/order/topup' : '/service/others'
                location.href = urls + '?phoneNumber=' + value + '&token=' + localStorage.getItem('token');
            }
        });
        $('#phoneId').keyup(function(event){
            const match = $('#match');
            $(this).val($(this).val().replace(/[^0-9]/g,''));
            const value = $(this).val();
            if (validatePhone(value)) {
                match.css("color", 'blue');
                match.text('Valid Phone Number');
            } else {
                match.css("color", 'red');
                match.text('Invalid Phone Number');
            }
        });
        $(window).bind("pageshow", function (event) {
            const match = $('#match');
            const value = $('#phoneId').val();
            if (validatePhone(value)) {
                match.css("color", 'blue');
                match.text('Valid Phone Number');
            } else {
                if (value != '') {
                    match.css("color", 'red');
                    match.text('Invalid Phone Number');
                }
            }
        });
        function closedView() {
            $(".close").parent(".head_bar").slideUp(1000);
        }
    </script>
    <footer>
        <% include ../common/footers %>
    </footer>
</body>

</html>