<!DOCTYPE html>
<html>
<head>
    <% include ../common/header %>
</head>
<body>
    <header>
        <% include ../common/navigator %>
    </header>
    <section>
        <h1 class="title">
            <% if(phone == null) { %>
            <span class="blind"><b>Step1</b> Number</span>
            Purchase Step
                <% if(category == 'order') { %>
                    <span><b>Step2 </b>Select Plan</span>
                <% } else {%>
                    <span><b>Step2 </b>Select Service</span>
                <% } %>
            <% }%>
        </h1>
        <h2 class="sub_title">
            <% if(phone == null) { %>
                Add Receive Phone Number
                <% if(token != "null") { %>
                    , Or Select Below List
                <% } %>
            <% } else { %>
                Update User Name And Phone Number
            <% } %>
        </h2>
        <div class="conts_wrap">
            <div class="purchase_wrap">
                <form class="form" action=
                <% if (id == null) { 
                    if (category == "order") {%>
                    "/order"
                    <% } else { %>
                    "/service"
                    <% } %>
                <% } else { %>
                    "/receiver/edit"
                <% } %>
                method="POST" id="submit-form">
                <input type="hidden" value="<%= token %>" id="token" name="token">
                <div class="input_box">
                    <h3>Phone Number</h3>
                    <div><input type="text" id="phoneId" name="phone"
                        <% if(phone == null) { %>
                            placeholder="Enter Phone Number"
                        <% } else { %>
                            value = "<%=phone %>"
                        <% } %>
                    ></div>
                    <small style="color: red;">Please check if the recipient phone number and mobile carrier match.</small><br>
                    <small><label id="match"></label></small>
                </div>
                <% if(token != "null") { %>
                <div class="input_box">
                    <h3>Name</h3>
                    <div><input type="text" class="form-control" id="nameId" name="name"
                        <% if(name == null) { %>
                            placeholder="Enter Receiver Name"
                        <% } else { %>
                            value="<%= name %>"
                        <% } %>
                            >
                    </div>
                    <% if(id != null) { %>
                        <input type="hidden" name="id" id="id" value="<%=id %>">
                    <% } %>
                </div>
                <% } %>

                <% if(id == null) { %>
                <div class="input_box">
                    <a style="color: blue; text-decoration: underline;" href="https://medium.com/hoolamoolah/why-and-how-paypal-is-used-on-hoolamoolah-b021471f2a30" target="_blank">Why and How Paypal is used on hoolamoolah</a>
                </div>
                <% } %>
                    
                <div class="btn_group">
                    <button id="btnSubmit">
                        <% if(id == null) { 
                            if (category == 'order') {%>
                            Select Plan
                            <% } else { %>
                                Select Service
                            <% } %>
                        <% } else { %>
                            Edit
                        <% } %>
                        </button>
                </div>
                </form>
                <div class="purchase_tbl mt_50">
                    <% if (id == null && token != "null") { %>
                        <% include receiver %>
                    <% } else { %>
                        <div class="nbgo_box1">
                            <p><img src="/static/images/using.png"></p>
                        </div>
                    <% } %>
                </div>
            </div>
        </div>
    </section>
    <script>
        $('#btnSubmit').click(function(event){
            const match = $('#match');
            if(match.text() != 'Valid Phone Number') {
                alert('Invalid Phone Number');
                return false;
            }
            $('#submit-form').submit();
        });
        $('#phoneId').keyup(function(event){
            const match = $('#match');
            $(this).val($(this).val().replace(/[^0-9]/g,''));
            const value = $(this).val();
            if (/^[1-9][0-9]{6,14}$/.test(value)) {
                match.css("color", 'blue');
                match.text('Valid Phone Number');
            } else {
                match.css("color", 'red');
                match.text('Invalid Phone Number');
            }
        });
        $(window).bind("pageshow", function (event) {
        const match = $('#match');
        const value = $('#phoneId').val();
        if (/^[1-9][0-9]{6,14}$/.test(value)) {
            match.css("color", 'blue');
            match.text('Valid Phone Number');
        } else {
            if (value != '') {
                match.css("color", 'red');
                match.text('Invalid Phone Number');
            }
        }
    });
    </script>
    <footer>
        <% include ../common/footers %>
    </footer>


</body>

</html>