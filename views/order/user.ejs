<!DOCTYPE html>
<html>
<head>
    <% include ../common/header %>
</head>
<body>
    <% include ../common/navigator %>
    <section>
        <h1 class="title">
            <% if(phone == null) { %>
            <span class="blind"><b>Step1</b> Number</span>
            Purchase Step
            <span><b>Step2 </b>View Product Category</span>
            <% }%>
        </h1>
        <h2 class="sub_title">
            <% if(phone == null) { %>
                Add Receive Phone Number, Or Select Below List
            <% } else { %>
                Update User Name And Phone Number
            <% } %>
        </h2>
        <div class="conts_wrap">
            <div class="purchase_wrap">
                <form class="form" action=
                <% if (id == null) { %>
                    "/receiver/add"
                <% } else { %>
                    "/receiver/edit"
                <% } %>
                method="POST" id="submit-form">
                <input type="hidden" value="<%= token %>" id="token" name="token">
                <div class="input_box">
                    <h3>Phone Number</h3>
                    <div><input type="text" id="phoneId" name="phone"
                        <% if(phone == null) { %>
                            placeholder="Enter Phone Number"
                        <% } else { %>
                            value = "<%=phone %>"
                        <% } %>
                    ></div>
                    <small style="color: red;">Please check if the recipient phone number and mobile carrier match. (The 0 after the country code may mistake the mobile carrier. Please check if the correct carrier is chosen when ordering.)</small><br>
                    <small><label id="match"></label></small>
                </div>
                <div class="input_box">
                    <h3>Name</h3>
                    <div><input type="text" class="form-control" id="nameId" name="name"
                        <% if(name == null) { %>
                            placeholder="Enter Receiver Name"
                        <% } else { %>
                            value="<%= name %>"
                        <% } %>
                         >
                    </div>
                    <% if(id != null) { %>
                        <input type="hidden" name="id" id="id" value="<%=id %>">
                    <% } %>
                </div>
                    
                <div class="btn_group">
                    <button id="btnSubmit">
                        <% if(id == null) { %>
                            View Product Category
                        <% } else { %>
                            Edit
                        <% } %>
                        </button>
                </div>
                </form>
                <div class="purchase_tbl mt_50">
                    <% if (id == null) { %>
                        <% include receiver %>
                    <% } %>
                </div>
            </div>
        </div>
    </section>
    <script>
        $('#btnSubmit').click(function(event){
            const match = $('#match');
            if(match.text() != 'Valid Phone Number') {
                alert('Invalid Phone Number');
                return false;
            }
            $('#submit-form').submit();
        });
        $('#phoneId').keyup(function(event){
            const match = $('#match');
            $(this).val($(this).val().replace(/[^0-9]/g,''));
            const value = $(this).val();
            if (/^[1-9][0-9]{6,14}$/.test(value)) {
                match.css("color", 'blue');
                match.text('Valid Phone Number');
            } else {
                match.css("color", 'red');
                match.text('Invalid Phone Number');
            }
        });
        $(window).bind("pageshow", function (event) {
        const match = $('#match');
        const value = $('#phoneId').val();
        if (/^[1-9][0-9]{6,14}$/.test(value)) {
            match.css("color", 'blue');
            match.text('Valid Phone Number');
        } else {
            if (value != '') {
                match.css("color", 'red');
                match.text('Invalid Phone Number');
            }
        }
    });
    </script>
    <footer>
        <% include ../common/footers %>
    </footer>


</body>

</html>