<table>
    <caption class="blind">Purchase update delete table</caption>
    <thead>
        <tr>
            <th class="txt_l">Receiver Name</th>
            <th class="txt_l">Phone number</th>
            <th>Update</th>
            <th>Delete</th>
        </tr>
    </thead>
    <tbody>
        <% for (var i = 0; i < page.content.length; i++) { %>
        <tr>
            <td> <%= page.content[i].receiverName %> </td>
            <td> <a href="/products/operator?operator=<%= page.content[i].operatorId%>&receiver=<%= page.content[i].id %>"><%= page.content[i].receiverNumber %></a> </td>
            <td class="txt_c"><button class="up"
                onclick="location.href='/order/edit?id=<%= page.content[i].id %>&name=<%= page.content[i].receiverName %>&phone=<%= page.content[i].receiverNumber %>&token=<%= token %>'">
                Update</button></td>
            <td class="txt_c"><button class="del" onclick="deleteReceiver(<%= page.content[i].id %>)">
                Delete</button></td>
        </tr>
        <% } %>
    </tbody>
</table>
<script>
    function deleteReceiver(value) {
        var con_test = confirm("Are you delete? " + value);
        if(con_test == true) {
            location.href='/receiver/delete/' + value + '?token=' + localStorage.getItem('token');
        }
    }
</script>