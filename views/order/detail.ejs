<!DOCTYPE html>
<html>

<head>
    <% include ../common/header %>
    <script src="/static/javascripts/purchase.js"></script>
</head>
<body>
    <% include ../common/navigator %>
    <section>
        <h1 class="title">
            <span><b>Step3</b> Select Plan</span>
            Payment
            <span class="blind"><b>Step3</b> Purchase</span>
        </h1>

        <div class="conts_wrap">
            <div class="purchase_wrap">
                <div class="purchase_tbl2 mt_50">
                    <table>
                        <caption class="blind">Purchase table</caption>
                        <colgroup>
                            <col style="width: 20%">
                            <col style="width: 30%">
                            <col style="width: 20%">
                            <col style="width: 30%">
                        </colgroup>
                        <tbody>
                            <% if (operator != 'hoolamoolah') { %>
                            <tr>
                                <th class="txt_l">Name</th>
                                <td><%= name%></td>
                                <th class="txt_l">Phone number</th>
                                <td><%= receiverPhone %></td>
                            </tr>
                            <% } %>
                            <tr>
                                <th class="txt_l">Operator</th>
                                <td><%= operator %></td>
                                <th class="txt_l">Product Name</th>
                                <td><%= productName%></td>
                            </tr>
                            <tr>
                                <th class="txt_l">Currency</th>
                                <td>USD</td>
                                <th class="txt_l">Price</th>
                                <td><%= salesAmount%>$</td>
                            </tr>
                            <% if (description != '') { %>
                            <tr>
                                <th class="txt_l">Description</th>
                                <td colspan="3"><%= description %></td>
                            </tr>
                            <% } %>
                            <tr>
                                <th class="txt_l">My HM Dollar</th>
                                <td><%= totalPoint %>$</td>
                            </tr>

                        </tbody>
                    </table>
                </div>
                <div class="payment_wrap">
                    <div class="payment_box">
                        <span>Order Price</span>
                        <span id="orderPrice"></span>
                        <i>-</i>
                    </div>
                    <div class="payment_box">
                        <span>Discount</span>
                        <span id="deductionAmount"></span>
                        <i>=</i>
                    </div>
                    <div class="payment_box">
                        <span>Total Amount</span>
                        <span id="finalPayment"></span>
                    </div>
                    <div class="payment_box">
                        <p>
                            <span>Price</span>
                            <span><%= salesAmount%>$</span>
                        </p>
                        <p>
                            <span>Processing Fee
                                <!-- <b class="tip"><img src="/static/images/img_tip.png"></b> -->
                                <em class="tipTxt">
                                Lorem Ipsum is simply dummy text of the printing and typesetting industry. 
                                    <a href="#a" class="close">Close</a>
                                </em>
                            </span>
                            <span id="processFee"></span>
                        </p>
                        <p>
                            <span>Total Price</span>
                            <span id="totalPrice"></span>
                        </p>
                    </div>
                    <div class="payment_box">
                        <p>
                            <span>HM Dollar</span>
                        </p>
                        <p>
                            <span>Available :<b id="ablePoint"> <%= totalPoint %></b></span>
                            <span><input type="number" id="discountFee"></span>
                        </p>
                        <p>
                            <span id="message"></span>
                        </p>
                    </div>
                    <div class="payment_box">
                        <div class="chk_wrap">
                            <input type="checkbox" id="term">
                            <label for="term">Did you check the payment and service user details?</label>
                        </div>
                    </div>
                </div>
                    <form action="<%= paypalUrl %>" method="post" id="buyPaypal">
                        <div class="btn_group">
                            <button class="btn_buy" id="paypalBtn" onclick="buyItem()" type="button">Buy</button>
                            <button class="btn_buy" id="pointBtn" onclick="buyPoint()" type="button">Buy Point</button>
                        </div>
                        <!-- required -->
                        <input type="hidden" name="cmd" value="_xclick"> 
                        <input type="hidden" name="business" value="<%= paypalId %>">
                        <input type="hidden" readonly name="item_name" value="<%= productName%>"> <br>
                        <input type="hidden" readonly name="item_number" value="<%= productId%>"> <br>
                        <input type="hidden" readonly name="currency_code" value="USD"> <br>
                        <input type="hidden" readonly id="submitAmount" name="amount" value=""> <br>
                        <!-- required -->
                        <input type="hidden" readonly id="useFee" name="fee"> <br>
                        <input type="hidden" id="custom" name="custom" value="">
                        <input type="hidden" name="charset" value="UTF-8">
                    </form>
                </div>
            </div>
        </div>
        <form action="/purchase/point" method="POST" id="buyPoint">
            <input type="hidden" readonly name="token">
            <input type="hidden" readonly name="productId" value="<%= productId%>">
            <input type="hidden" readonly name="pointAmount" value="<%= salesAmount %>">
            <input type="hidden" readonly name="receiver" value="<%= receiverPhone %>">
        </form>
    </section>
    <footer>
        <% include ../common/footers %>
    </footer>

    <script>
    const productTotalAmount = <%= salesAmount %>;
    const buyThisMonth = <%= buyThisMonth %>;
    const totalPoint = <%= totalPoint %>;
    const ablePoint = <%= totalPoint %>;
    const isPayable = <%= payable %>;
    const processFee = getProcessFee(productTotalAmount);
    $('#discountFee').val(0);
    $(document).ready(function(){
        $('#pointBtn').hide(); // disable all buy point
        $('input[name=token]').val(localStorage.getItem('token'));
        feeProcess(productTotalAmount);
        var usePoint = 0;
        isAblePoint();
    });
    </script>
</body>

</html>