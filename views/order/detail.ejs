<!DOCTYPE html>
<html>

<head>
    <% include ../common/header %>
    <script src="/static/javascripts/purchase.js"></script>
    <script src="/static/javascripts/member.js"></script>
    <script src="/static/javascripts/validate.js"></script>
</head>
<body>
    <header>
        <% include ../common/navigator %>
    </header>
    <section>
        <h1 class="title">
            <span><b><%= __('oder_detail_1') %></b> <%= __('oder_detail_2') %></span>
            <%= __('oder_detail_3') %>
            <span class="blind"><b><%= __('oder_detail_4') %></b> <%= __('oder_detail_5') %></span>
        </h1>

        <div class="conts_wrap">
            <div class="purchase_wrap">
                <div class="purchase_tbl2 mt_50">
                    <table>
                        <caption class="blind"><%= __('oder_detail_6') %></caption>
                        <colgroup>
                            <col style="width: 20%">
                            <col style="width: 30%">
                            <col style="width: 20%">
                            <col style="width: 30%">
                        </colgroup>
                        <tbody>
                            <tr>
                                <th class="txt_l"><%= __('oder_detail_7') %></th>
                                <% if (operator != 'hoolamoolah') { %>
                                    <td><%= name%></td>
                                <% } else { %>
                                    <td></td>
                                <% } %>
                                <th class="txt_l"><%= __('oder_detail_8') %></th>
                                <% if (operator != 'hoolamoolah') { %>
                                    <td><%= receiverPhone %></td>
                                <% } else { %>
                                    <td></td>
                                <% } %>
                            </tr>
                            <tr>
                                <th class="txt_l"><%= __('oder_detail_9') %></th>
                                <td><%= operator %></td>
                                <th class="txt_l"><%= __('oder_detail_10') %></th>
                                <td><%= productName%></td>
                            </tr>
                            <tr>
                                <th class="txt_l"><%= __('oder_detail_11') %></th>
                                <td>USD</td>
                                <th class="txt_l"><%= __('oder_detail_12') %></th>
                                <td><%= salesAmount%>$</td>
                            </tr>
                            <tr>
                                <th class="txt_l"><%= __('oder_detail_13') %></th>
                                <td><%= totalPoint %>$</td>
                            </tr>
                            <% if (description != '') { %>
                            <tr>
                                <th class="txt_l"><%= __('oder_detail_14') %></th>
                                <td colspan="3"><%= description %></td>
                            </tr>
                            <% } %>
                            <% if (service > 1) { %>
                            <tr>
                                <th class="txt_l"><%= __('oder_detail_15') %></th>
                                <td colspan="3"><input placeholder="Account (Optional)" id="account"></td>
                            </tr>
                            <% } %>
                            <% if (referralCode == '') { %>
                            <tr>
                                <th class="txt_l"><%= __('oder_detail_16') %></th>
                                <td colspan="3"><input placeholder="<%= __('oder_detail_34') %>" id="noneMember" autofocus></td>
                            </tr>
                            <% } %>
                        </tbody>
                    </table>
                <% if (referralCode == '') { %>
                <div class="nonemember">
                    <%= __('oder_detail_17') %>
                </div>
                <% } %>
                </div>
                <div class="payment_wrap">
                    <div class="payment_box">
                        <span><%= __('oder_detail_18') %></span>
                        <span id="orderPrice"></span>
                        <i>-</i>
                    </div>
                    <div class="payment_box">
                        <span><%= __('oder_detail_19') %></span>
                        <span id="deductionAmount"></span>
                        <i>=</i>
                    </div>
                    <div class="payment_box">
                        <span><%= __('oder_detail_20') %></span>
                        <span id="finalPayment"></span>
                    </div>
                    <div class="payment_box">
                        <p>
                            <span><%= __('oder_detail_21') %></span>
                            <span><%= salesAmount%>$</span>
                        </p>
                        <p>
                            <span><%= __('oder_detail_22') %>
                                <!-- <b class="tip"><img src="/static/images/img_tip.png"></b> -->
                                <em class="tipTxt">
                                    <%= __('oder_detail_23') %> 
                                    <a href="#a" class="close"><%= __('oder_detail_24') %></a>
                                </em>
                            </span>
                            <span id="processFee"></span>
                        </p>
                        <p>
                            <span><%= __('oder_detail_25') %></span>
                            <span id="totalPrice"></span>
                        </p>
                    </div>
                    <div class="payment_box">
                        <p>
                            <span><%= __('oder_detail_26') %></span>
                        </p>
                        <p>
                            <span><%= __('oder_detail_27') %> :<b id="ablePoint"> <%= totalPoint %></b></span>
                            <span><input type="number" id="discountFee"></span>
                        </p>
                    </div>
                    <div class="payment_box">
                        <div class="chk_wrap">
                            <input type="checkbox" id="term">
                            <label for="term"><%= __('oder_detail_28') %></label>
                            <span id="message"></span>
                        </div>
                    </div>
                </div>
                    <form action="<%= paypalUrl %>" method="post" id="buyPaypal">
                        <div class="btn_group">
                            <button class="on" id="signup" onclick="buySignUp()" type="button"><%= __('oder_detail_29') %></button>
                            <button id="login" onclick="buyLogIn()" type="button"><%= __('oder_detail_30') %></button>
                            <% if (referralCode != '') { %>
                                <button class="btn_buy" id="paypalBtn" onclick="buyItem()" type="button"><%= __('oder_detail_31') %></button>
                            <% } else { %>
                                <button class="on" id="paypalBtn" onclick="buyItem()" type="button"><%= __('oder_detail_32') %></button>
                            <% } %>
                            <button class="btn_buy" id="pointBtn" onclick="buyPoint()" type="button"><%= __('oder_detail_33') %></button>
                        </div>
                        <!-- required -->
                        <input type="hidden" name="cmd" value="_xclick"> 
                        <input type="hidden" name="business" value="<%= paypalId %>">
                        <input type="hidden" readonly name="item_name" value="<%= productName%>"> <br>
                        <input type="hidden" readonly name="item_number" value="<%= productId%>"> <br>
                        <input type="hidden" readonly name="currency_code" value="USD"> <br>
                        <input type="hidden" readonly id="submitAmount" name="amount" value=""> <br>
                        <!-- required -->
                        <input type="hidden" readonly id="useFee" name="fee"> <br>
                        <input type="hidden" id="custom" name="custom" value="">
                        <input type="hidden" name="charset" value="UTF-8">
                    </form>
                </div>
            </div>
        </div>
        <form action="/purchase/point" method="POST" id="buyPoint">
            <input type="hidden" readonly name="token">
            <input type="hidden" readonly name="productId" value="<%= productId%>">
            <input type="hidden" readonly name="pointAmount" value="<%= salesAmount %>">
            <input type="hidden" readonly name="receiver" value="<%= receiverPhone %>">
        </form>
    </section>
    <footer>
        <% include ../common/footers %>
    </footer>

    <script>
    const productTotalAmount = <%= salesAmount %>;
    const level = <%= level %>;
    const totalPoint = <%= totalPoint %>;
    const ablePoint = <%= totalPoint %>;
    const isPayable = <%= payable %>;
    const processFee = <%= fee %>;
    var referralCode = '<%= referralCode %>';
    const receivePhone = '<%= receiverPhone %>';
    const memberCode = "<%= referralCode %>";
    $('#discountFee').on("propertychange change keyup paste input", function () {
        calculateDiscount($(this).val());
    });
    </script>
</body>

</html>