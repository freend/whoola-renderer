        <table class="table table-striped">
                <tr>
                    <td> id </td>
                    <td> Title </td>
                    <td> Date </td>
                </tr>
            <% for (var i = 0; i < page.content.length; i++) { %>
                <tr>
                    <td><%= page.content[i].id %></td>
