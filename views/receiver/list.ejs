<!DOCTYPE html>
<script type="text/javascript">
document.addEventListener("DOMContentLoaded", function(){
    var token = localStorage.getItem('token');
    document.getElementById('token').value = localStorage.getItem('token');
});
function deleteReceiver(value) {
    var con_test = confirm("Are you delete? " + value);
    if(con_test == true) {
        location.href='/receiver/delete/' + value + '?token=' + localStorage.getItem('token');
    }
}
</script>
<html lang="en">
  <head>
    <% include ../common/head %>
    <link rel="stylesheet" href="/stylesheets/step.css">
  </head>
  <body>
  <% include ../common/navi %>
    <div class="container-fluid">
      <div class="container my-3">
        <h1 class="h3 mb-3 font-weight-normal" align="center"><%= __('receiver_3_1') %></h1>
        <div class="container" align="center">
          <ul id="progressbar" class="text-center">
              <li class="active" id="step1"><div class="d-none d-md-block"><%= __('receiver_3_2') %></div></li>
              <li class="" id="step2"><div class="d-none d-md-block"><%= __('receiver_3_3') %></div></li>
              <li class="" id="step3"><div class="d-none d-md-block"><%= __('receiver_3_4') %></div></li>
          </ul>
        </div>
       <div class="card">
         <div class="card-body">
           <%= __('receiver_3_11') %>
         </div>
       </div>
    </div>
    <% include ../receiver/add %>
    <input type="hidden" id="token" value="">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th> <%= __('receiver_3_5') %> </th>
                    <th> <%= __('receiver_3_6') %> </th>
                    <th> <%= __('receiver_3_7') %> </th>
                    <th> <%= __('receiver_3_8') %> </th>
                </tr>
            </thead>
            <tbody>
                <% for (var i = 0; i < page.content.length; i++) { %>
                    <tr>
                        <td><%= page.content[i].receiverName %></td>
                        <td><a href="/products/operator/service?operator=<%= page.content[i].operatorId%>&receiver=<%= page.content[i].id %>"><%= page.content[i].receiverNumber %></a></td>
                        <td><button class="btn btn-warning" onclick="location.href='/receiver/edit?id=<%= page.content[i].id %>&name=<%= page.content[i].receiverName %>&phone=<%= page.content[i].receiverNumber %>'"><%= __('receiver_3_9') %></button> </td>
                        <td><button class="btn btn-danger" onclick="deleteReceiver(<%= page.content[i].id %>)"><%= __('receiver_3_10') %></button> </td>
                    </tr>
                <% } %>
            </tbody>
        </table>
        <% if (page.content.length != 0) {%>
            <% include ../common/pagenation %>
        <% } %>
    </div>
  </body>
</html>
<% include ../common/footer %>