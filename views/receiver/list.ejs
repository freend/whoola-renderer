<!DOCTYPE html>
<script type="text/javascript">
document.addEventListener("DOMContentLoaded", function(){
    var token = localStorage.getItem('token');
    document.getElementById('token').value = localStorage.getItem('token');
});
</script>
<html lang="en">
  <head>
    <% include ../common/head %>
  </head>
  <body>
  <% include ../common/navi %>
    <div class="container">
        <table class="table table-striped">
            <thead>
                <td> Receiver name </td>
                <td> Phone number </td>
                <td> Option </td>
            </thead>
            <% for (var i = 0; i < content.length; i++) { %>
                <tr>
                    <td><%= content[i].receiverName %></td>
                    <td><a href="/products/operator?operator=<%= content[i].operatorId%>&receiver=<%= content[i].id %>"><%= content[i].receiverNumber %></a><td>
                    <td> <button class="btn" type="submit">Update</button><button class="btn" type="submit">Delete</button> </td>
                </tr>
            <% } %>
        </table>
        <% if (content.length != 0) {%>
            <% include ../common/pagenation %>
        <% } %>
        <% include ../receiver/add %>
    </div>
  </body>
</html>