<!DOCTYPE html>
<script type="text/javascript">
document.addEventListener("DOMContentLoaded", function(){
    var token = localStorage.getItem('token');
    document.getElementById('token').value = localStorage.getItem('token');
});
function deleteReceiver(value) {
    var con_test = confirm("Are you delete? " + value);
    if(con_test == true) {
        location.href='/receiver/delete/' + value + '?token=' + localStorage.getItem('token');
    }
}
</script>
<html lang="en">
  <head>
    <% include ../common/head %>
  </head>
  <body>
  <% include ../common/navi %>
    <div class="container">
    <input type="hidden" id="token" value="">
        <table class="table table-striped">
            <thead>
                <td> Receiver name </td>
                <td> Phone number </td>
                <td> Option </td>
            </thead>
            <% for (var i = 0; i < page.content.length; i++) { %>
                <tr>
                    <td><%= page.content[i].receiverName %></td>
                    <td><a href="/products/operator?operator=<%= page.content[i].operatorId%>&receiver=<%= page.content[i].id %>"><%= page.content[i].receiverNumber %></a><td>
                    <td> <button class="btn" onclick="location.href='/receiver/edit?id=<%= page.content[i].id %>&name=<%= page.content[i].receiverName %>&phone=<%= page.content[i].receiverNumber %>'">Update</button>
                    <button class="btn" onclick="deleteReceiver(<%= page.content[i].id %>)">Delete</button> </td>
                </tr>
            <% } %>
        </table>
        <% if (page.content.length != 0) {%>
            <% include ../common/pagenation %>
        <% } %>
        <% include ../receiver/add %>
    </div>
  </body>
</html>
<% include ../common/footer %>