<!DOCTYPE html>
<div class="container">
        <form class="form" action=
        <% if (id == null) { %>
            "/receiver/add"
        <% } else { %>
            "/receiver/edit"
        <% } %>
        method="POST" id="submit-form">
          <div class="form-group">
            <label >Phone Number</label>
            <label >use only number not use dash or space</label>
            <label id="match">Phone number</label>
            <input type="text" class="form-control" id="phoneId" name="phone"
            <% if(phone == null) { %>
                placeholder="Insert phone number"
            <% } else { %>
                value="<%= phone %>"
            <% } %>
            >
          <div/>
          <div class="form-group">
            <input type="hidden" value="" id="token" name="token">
              <% if (id != null) {%>
                  <input type="hidden" value="<%= id %>" id="id" name="id">
              <% } %>
              <label >Name</label>
              <input type="text" class="form-control" id="nameId" name="name"
              <% if(name == null) { %>
                  placeholder="insert invite name"
              <% } else { %>
                  value="<%= name %>"
              <% } %>
               >
          </div>
          <button type="button" id="btnSubmit" class="btn btn-info">
          <% if(id == null) { %>
              Select Category
          <% } else { %>
              Edit
          <% } %>
          </button>
        </form>
    </div>
    <script>
        $('#btnSubmit').click(function(event){
            const match = $('#match');
            console.log('check : ' + match.text());
            if(match.text() != 'Right Phone Number') {
                alert('check receive phone number');
                return false;
            }
            $('#submit-form').submit();
        });
        $('#phoneId').keyup(function(event){
            const match = $('#match');
            $(this).val($(this).val().replace(/[^0-9]/g,''));
            const value = $(this).val();
            if (/^[1-9][0-9]{6,14}$/.test(value)) {
                match.css("color", 'blue');
                match.text('Right Phone Number');
            } else {
                match.css("color", 'red');
                match.text('Wrong Phone Number');
            }
        });
    </script>