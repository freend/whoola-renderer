<!DOCTYPE html>
<html lang="en">

<head>
  <% include ../common/header %>
  <link rel="stylesheet" type="text/css" href="/static/stylesheets/aos.css">
    <script src="/static/javascripts/aos.js"></script>
</head>

<body>
  <header>
    <% include ../common/navigator %>
  </header>
  <div class="topTitle"> </div>
  <section>
    <h1 class="title">hoolamoolah<br>Business Partner</h1>
    <div class="conts_wrap">
        <div class="hmbp_wrap">
           <div class="hmbp_box1" data-aos="fade-up" data-aos-easing="ease">
               Become a hoolamoolah Business Partner.<br>
               hoolamoolah Sincerely Supports the<br>
               Success of our Business Partners.
            </div>
            <div class="hmbp_box2" data-aos="fade-up" data-aos-easing="ease">
                <div class="box2_left">
                    <p>
                        <span>10%</span>
                        <img src="/static/images/img02.png">
                    </p>
                    <p>10% Commission</p>
                    <p>Up to 10% rebate on entire margin</p>
                </div>
                <div class="box2_right">
                    <p><img src="/static/images/img01.png"></p>
                    <p>1:1 Account Manager</p>
                    <p>We support our Business Partners with 1:1 Support</p>
                </div>
            </div>
            <div class="hmbp_box3" data-aos="fade-up" >
               One and Only <br>
                Industry Commission Rebate Program
            </div>
            <div class="hmbp_box4" data-aos="fade-up" >
                <div class="box4_01">Commission Depending on Consumption Level</div>
                <div class="box4_02">
                    <img src="/static/images/img03.png">
                </div>
            </div>
            
            <div class="tab_wrap" data-aos="fade-up">
                <div class="main_box2">
                    <div class="box2_02" style="vertical-align: top">
                        <div class="con_box">
                            <table>
                                <thead>
                                    <tr>
                                        <th colspan="2">
                                            <img src="/static/images/icon_user.png">
                                            Consumer
                                        </th>
                                    </tr>                                    
                                </thead>
                                <tbody>
                                    <tr>
                                        <th>Requirements</th>
                                        <td id="td1">None</td>
                                    </tr>
                                    <tr>
                                        <th>
                                            Payback
                                        </th>
                                        <td id="td2">
                                            <p>3% in Total</p>
                                            <p>3% of Purchase Amount<br>on Tier 1 Customers</p>
                                            <p></p>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                        <div class="prim_box">
                            <table>
                                <thead>
                                    <tr>
                                        <th colspan="2">
                                            <img src="/static/images/icon_premium.png">
                                            Premium
                                        </th>
                                    </tr>                                    
                                </thead>
                                <tbody>
                                    <tr>
                                        <th>Requirements</th>
                                        <td>Minimum monthly<br>spending over $50</td>
                                    </tr>
                                    <tr>
                                        <th>
                                            Payback
                                        </th>
                                        <td>
                                            <p>10% in Total</p>
                                            <p>9% of Purchase Amount<br>on Tier 1 Customers</p>
                                            <p>1% of Purchase Amount on<br>Tier 2 Customers</p>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                        <div class="fam_box">
                            <table>
                                <thead>
                                    <tr>
                                        <th colspan="2">
                                            <img src="/static/images/icon_family.png">
                                            Family
                                        </th>
                                    </tr>                                    
                                </thead>
                                <tbody>
                                    <tr>
                                        <th>Requirements </th>
                                        <td>Minimum monthly<br>spending over $20</td>
                                    </tr>
                                    <tr>
                                        <th>Payback </th>
                                        <td>
                                            <p>6% in Total</p>
                                            <p>5% of Purchase Amount<br>on Tier 1 Customers</p>
                                            <p>1% of Purchase Amount on<br>Tier 2 Customers</p>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                        <div class="cautions_box">
                            <p class="title">Note</p>
                            
                            <p><span class="bold">*Tier 1</span> means Direct Customers <br>
                            <span class="bold">*Tier 2</span> means Direct customers of Tier 1 customer <br>
                            The monthly spending will be reset on the <b class="color_p">1st day of each month.</b>
                        </div>
                    </div>
                </div>
            </div>

            
            <div class="hmbp_box5" data-aos="fade-up" >
              <span>Business Enquiries</span>
              <span>
                  You will receive a response within 24 hours<br>
                  support@hollamoolah.com
                </span>
            </div>
        </div>
    </div>
</section>
  <footer>
    <% include ../common/footers %>
</footer>
</body>
</html>
