<!DOCTYPE html>
<html>
  <head>
    <% include ../common/header %>
    <script src="/static/javascripts/purchase.js"></script>
    <script src="/static/javascripts/member.js"></script>
</head>
<body>
  <% include ../common/navigator %>
  <section>
    <h1 class="title">
        Withdraw
    </h1>
    <h2 class="sub_title">
      <% if(buyMonth < 20) { %>
        <p>In order to withdraw HM Dollar, your purchase during the month must be more than $20.</p>
      <% } %>
      <p>You will receive a verification email on withdrawal. The withdrawal will not be processed if not verified.</p>
  </h2>
    <div class="conts_wrap">
      <div class="puchase_wrap">
        <div class="withdraw_tbl2 mt_50">
          <table>
              <caption class="blind">Purchase table</caption>
              <colgroup>
                  <col style="width: 20%">
                  <col style="width: 30%">
                  <col style="width: 20%">
                  <col style="width: 30%">
              </colgroup>
              <tbody>
                  <tr>
                      <th class="txt_l">Pay pal Account</th>
                      <td><%= paypalAccount %></td>
                      <th class="txt_l">Buy This Month</th>
                      <td><%= buyMonth %></td>
                  </tr>
              </tbody>
          </table>
      </div>
      </div>
      <div class="withdraw_wrap">
        <div class="withdraw_tbl mt_50">
          <table>
            <caption class="blind">Purchase table</caption>
            <colgroup>
              <col style="width: 75%">
              <col style="width: 25%">
    
            </colgroup>
            <tbody>
              <tr>
                <th>My HM Dollar</th>
                <td><%= haveAmount %></td>
              </tr>
              <tr>
                <th>Enter Withdrawal Amount</th>
                <td><input id="viewAmount" type="number" placeholder="<%= availAmount %>"></td>
              </tr>
              <tr>
                <th>Withdrawal Fee</th>
                <td id="viewFee"></td>
              </tr>
              <tr></tr>
            </tbody>
          </table>
        </div>
        <div class="payment_wrap withdraw">
          <div class="payment_box withdraw">
            <span>My HM Dollar</span>
            <span><%= haveAmount %></span>
            <i>-</i>
          </div>
          <div class="payment_box withdraw">
            <span>Withdraw Amount</span>
            <span id="totalAmount"></span>
            <i>=</i>
          </div>
          <div class="payment_box withdraw">
            <span>Balance</span>
            <span id="remainAmount"></span>
          </div>
        </div>
        <form class="form" action="/withdraw" method="POST" id="form-submit">
          <div class="btn_group">
            <input type="hidden" value="<%= token %>" id="token" name="token">
            <input type="hidden" name="fee" id="requestFee">
            <input type="hidden" name="amount" id="requestAmount">
            <button class="btn_request" type="button" onclick="requestCheck()">Request</button>
            <button class="on" id="signup" onclick="buySignUp()" type="button">Register</button>
            <button id="login" onclick="buyLogIn()" type="button">Log in</button>
          </div>
        </form>
      </div>
    </div>
    <!--pay pal account pop up-->
    <% if (paypalAccount == null && token != null) { %>
    <div class="conts_pop" style="display: block">
      <div class="pop_wrap" style="">
        <h1>Withdrawal Invalid</h1>
        <p>You do not have a registered Paypal account.</p>
        <p class="bold">If you would like to withdraw, please register a Paypal account and please try again.</p>
        <div class="btn_group">
          <button class="btn_submit" onClick="setToken('/users/paypal?token=')">Go</button>
        </div>
      </div>
      <% } %>
    </div>
  </section>
  <footer>
      <% include ../common/footers %>
  </footer>
  <script>
    var totalAmount = 0;
    var requestAmount = 0;
    var totalFee = 0;
    var requestFee = 0;
    var limitAmount= 0;
    var buyMonth = 0;

    window.onload = function() {
        buyMonth = <%= buyMonth %>;
        totalAmount = <%= haveAmount %>;
        requestAmount = <%= availAmount %>;
        limitAmount = <%= availAmount %>;
        totalFee = <%= fee %>;
        requestFee = <%= fee %>;
        underRequestAmount(buyMonth);
        $('#viewAmount').val(requestAmount);
        const memberCode = "<%= token %>";
        if (memberCode == "null") {
            initNonMember(true);
        } else {
            initNonMember(false);
        }
        changeValue();
    }
    function underRequestAmount(value) {
      if (value < 20) {
        $('.btn_request').attr('disabled', true);
        $('#viewAmount').attr('disabled', true);
        requestAmount = 0;
        requestFee = 0;
      }
    }
    function changeValue() {
        // display fee
        $('#viewFee').text(strictFloat(requestFee));
        // request fee
        $('#requestFee').val(requestFee);
        $('#requestAmount').val(requestAmount);
        // bottom calculate.
        $('#totalAmount').text(strictFloat(requestAmount + requestFee));
        $('#remainAmount').text(strictFloat(totalAmount - (requestAmount + requestFee)));
    }
    $('#viewAmount').on("propertychange change keyup paste input", function () {
      requestAmount = parseFloat($(this).val());
      requestFee = strictFloat(requestAmount * 0.1);
      if ($(this).val() < 0) {
        $(this).val(0);
      }
      if ($(this).val() == '') {
        requestAmount = 0;
        requestFee = 0;
      }
      if (requestAmount >= limitAmount) {
        requestAmount = limitAmount;
        requestFee = totalFee;
        $(this).val(limitAmount);
      };
      changeValue();
    });
    function setToken(value) {
        location.href = value + localStorage.getItem('token');
    }
    function strictFloat(value) {
      return parseFloat(new Number(value).toFixed(2));
    }
    function requestCheck() {
      underRequestAmount(requestAmount + requestFee);
      if (requestAmount == 0 || $('#requestAmount').val() == '') {
        alert('Insufficient HM Dollar to withdraw');
        return false;
      }
      
      const result = confirm("Do you want to withdraw " + requestAmount + "HM Dollar? (Processing fee:" + requestFee + "HM Dollar)");
      if(result){
        $('#form-submit').submit();
      }else{
          alert("Your withdrawal request has been successfully cancelled.");
      }
    }
  </script>
</body>

</html>