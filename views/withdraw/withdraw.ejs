<!DOCTYPE html>
<html>
  <head>
    <% include ../common/header %>
    <script src="/static/javascripts/purchase.js"></script>
    <script src="/static/javascripts/member.js"></script>
</head>
<body>
  <header>
        <% include ../common/navigator %>
    </header>
  <section>
    <h1 class="title">
      <%= __('withdraw_2_1') %>
    </h1>
    <h2 class="sub_title">
      <% if(level < 2) { %>
        <p><%= __('withdraw_2_2') %></p>
      <% } %>
      <p><%= __('withdraw_2_3') %></p>
  </h2>
    <div class="conts_wrap">
      <div class="puchase_wrap">
        <div class="withdraw_tbl2 mt_50">
          <table>
              <caption class="blind"><%= __('withdraw_2_4') %></caption>
              <colgroup>
                  <col style="width: 20%">
                  <col style="width: 30%">
                  <col style="width: 20%">
                  <col style="width: 30%">
              </colgroup>
              <tbody>
                  <tr>
                      <th class="txt_l"><%= __('withdraw_2_5') %></th>
                      <td><%= paypalAccount %></td>
                      <th class="txt_l"><%= __('withdraw_2_6') %></th>
                      <% switch (level) {
                        case 1 :%>
                        <td><%= __('withdraw_2_7') %></td>
                      <% break;
                      case 2 :%>
                      <td><%= __('withdraw_2_8') %></td>
                      <% break;
                      case 3 :%>
                      <td><%= __('withdraw_2_9') %></td>
                      <% break; 
                      } %>
                  </tr>
              </tbody>
          </table>
      </div>
      </div>
      <div class="withdraw_wrap">
        <div class="withdraw_tbl mt_50">
          <table>
            <caption class="blind"><%= __('withdraw_2_10') %></caption>
            <colgroup>
              <col style="width: 75%">
              <col style="width: 25%">
    
            </colgroup>
            <tbody>
              <tr>
                <th><%= __('withdraw_2_11') %></th>
                <td><%= haveAmount %></td>
              </tr>
              <tr>
                <th><%= __('withdraw_2_12') %></th>
                <td><input id="viewAmount" type="number" placeholder="<%= availAmount %>"></td>
              </tr>
              <tr>
                <th><%= __('withdraw_2_13') %></th>
                <td id="viewFee"></td>
              </tr>
              <tr></tr>
            </tbody>
          </table>
        </div>
        <div class="payment_wrap withdraw">
          <div class="payment_box withdraw">
            <span><%= __('withdraw_2_14') %></span>
            <span><%= haveAmount %></span>
            <i>-</i>
          </div>
          <div class="payment_box withdraw">
            <span><%= __('withdraw_2_15') %></span>
            <span id="totalAmount"></span>
            <i>=</i>
          </div>
          <div class="payment_box withdraw">
            <span><%= __('withdraw_2_16') %></span>
            <span id="remainAmount"></span>
          </div>
        </div>
        <form class="form" action="/withdraw" method="POST" id="form-submit">
          <div class="btn_group">
            <input type="hidden" value="<%= token %>" id="token" name="token">
            <input type="hidden" name="fee" id="requestFee">
            <input type="hidden" name="amount" id="requestAmount">
            <button class="btn_request" type="button" onclick="requestCheck()"><%= __('withdraw_2_17') %></button>
            <button class="on" id="signup" onclick="buySignUp()" type="button"><%= __('withdraw_2_18') %></button>
            <button id="login" onclick="buyLogIn()" type="button"><%= __('withdraw_2_19') %></button>
          </div>
        </form>
      </div>
    </div>
    <!--pay pal account pop up-->
    <% if (paypalAccount == null && token != null) { %>
    <div class="conts_pop" style="display: block">
      <div class="pop_wrap" style="">
        <h1><%= __('withdraw_2_20') %></h1>
        <p><%= __('withdraw_2_21') %></p>
        <p class="bold"><%= __('withdraw_2_22') %></p>
        <div class="btn_group">
          <button class="btn_submit" onClick="setToken('/users/paypal?token=')"><%= __('withdraw_2_23') %></button>
        </div>
      </div>
      <% } %>
    </div>
  </section>
  <footer>
      <% include ../common/footers %>
  </footer>
  <script>
    var totalAmount = 0;
    var requestAmount = 0;
    var totalFee = 0;
    var requestFee = 0;
    var limitAmount= 0;
    var level = 0;

    window.onload = function() {
        level = <%= level %>;
        totalAmount = <%= haveAmount %>;
        requestAmount = <%= availAmount %>;
        limitAmount = <%= availAmount %>;
        totalFee = <%= fee %>;
        requestFee = <%= fee %>;
        underRequestAmount(level);
        $('#viewAmount').val(requestAmount);
        const memberCode = "<%= token %>";
        if (memberCode == "null") {
            initNonMember(true);
        } else {
            initNonMember(false);
        }
        changeValue();
    }
    function underRequestAmount(value) {
      if (value < 2) {
        $('.btn_request').attr('disabled', true);
        $('#viewAmount').attr('disabled', true);
        requestAmount = 0;
        requestFee = 0;
      }
    }
    function changeValue() {
        // display fee
        $('#viewFee').text(strictFloat(requestFee));
        // request fee
        $('#requestFee').val(requestFee);
        $('#requestAmount').val(requestAmount);
        // bottom calculate.
        $('#totalAmount').text(strictFloat(requestAmount + requestFee));
        $('#remainAmount').text(strictFloat(totalAmount - (requestAmount + requestFee)));
    }
    $('#viewAmount').on("propertychange change keyup paste input", function () {
      requestAmount = parseFloat($(this).val());
      requestFee = strictFloat(requestAmount * 0.1);
      if ($(this).val() < 0) {
        $(this).val(0);
      }
      if ($(this).val() == '') {
        requestAmount = 0;
        requestFee = 0;
      }
      if (requestAmount >= limitAmount) {
        requestAmount = limitAmount;
        requestFee = totalFee;
        $(this).val(limitAmount);
      };
      changeValue();
    });
    function setToken(value) {
        location.href = value + localStorage.getItem('token');
    }
    function strictFloat(value) {
      return parseFloat(new Number(value).toFixed(2));
    }
    function requestCheck() {
      if (requestAmount == 0 || $('#requestAmount').val() == '') {
        alert('Insufficient HM Dollar to withdraw');
        return false;
      }
      
      const result = confirm("Do you want to withdraw " + requestAmount + "HM Dollar? (Processing fee:" + requestFee + "HM Dollar)");
      if(result){
        $('#form-submit').submit();
      }else{
          alert("Your withdrawal request has been successfully cancelled.");
      }
    }
  </script>
</body>

</html>