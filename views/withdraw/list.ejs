<!DOCTYPE html>
<script type="text/javascript">
document.addEventListener("DOMContentLoaded", function(){
    var token = localStorage.getItem('token');
    document.getElementById('token').value = localStorage.getItem('token');
});
</script>
<html lang="en">
  <head>
    <% include ../common/head %>
  </head>
  <body>
  <% include ../common/navi %>
    <div class="container">
        <table class="table table-striped">
            <thead>
                <td> State </td>
                <td> Amount </td>
                <td> Fee </td>
                <td> Message </td>
                <td> Create </td>
                <td> Response </td>
            </thead>
            <% for (var i = 0; i < page.content.length; i++) { %>
                <tr>
                    <td><%= page.content[i].withdrawState %></td>
                    <td> USD <%= (page.content[i].amount / 100) %></td>
                    <td><%= (page.content[i].fee / 100) %></td>
                    <td><%= page.content[i].content %></td>
                    <td><%= page.content[i].createAt %></td>
                    <td><%= page.content[i].responseAt %></td>
                </tr>
            <% } %>
        </table>
        <% if (page.content.length != 0) {%>
            <% include ../common/pagenation %>
        <% } %>
    </div>
  </body>
</html>
<% include ../common/footer %>