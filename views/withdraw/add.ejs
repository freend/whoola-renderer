<!DOCTYPE html>
<script type="text/javascript">
document.addEventListener("DOMContentLoaded", function(){
    var token = localStorage.getItem('token');
    document.getElementById('token').value = localStorage.getItem('token');
});
</script>
<html lang="en">
  <head>
    <% include ../common/head %>
  </head>
  <body>
  <% include ../common/navi %>
    <div class="container">
        <div class="container">
              <input type="hidden" id="availAmount" value="<%= availAmount%>">
              <input type="hidden" id="totalAmount" value="<%= haveAmount%>">
              <input type="hidden" id="maxfee" value="<%= fee%>">
            <form class="form" action="/withdraw" method="POST">
              <input type="hidden" value="" id="token" name="token">
              <div class="form-group">
                <label>Withdraw HM dollar : <%= haveAmount%></label>
                <label>Withdraw max fee : </label><label id="fee"><%= fee%></label>
                <div class="input-group mb-3">
                  <div class="input-group-prepend">
                    <span class="input-group-text">$</span>
                    <span class="input-group-text"><%= availAmount %></span>
                  </div>
                  <input type="number" numberOnly class="form-control"
                  aria-label="Amount (to the nearest dollar)" id="amount" name="amount" value="0">
                  <input type="hidden" name="fee" id="acceptFee">
                </div>
              <div/>
              <div class="form-group">
                <button type="submit" class="btn btn-info">Request</button>
              </div>
            </form>
        </div>
    </div>
  </body>
</html>
<script>
$(document).ready(function(){
    var requestWithdraw;
});
  $('#amount').on("propertychange change keyup paste input", function() {
    if (/^\d+(?:[.]?[\d]?[\d])?$/.test($(this).val())) {
      requestWithdraw = $(this).val();
    } else {
      if ($(this).val().length <= 1) {
        requestWithdraw = '';
      }
      $(this).val(requestWithdraw);
    }
    var fees = parseInt($(this).val() * 100) / 100;
    $('#fee').text(Math.ceil(fees) / 100);
    $('#acceptFee').val($('#fee').text());
    if (parseFloat($(this).val()) >= parseFloat($('#availAmount').val())) {
      $(this).val($('#availAmount').val());
      $('#fee').text($('#maxfee').val());
      $('#acceptFee').val($('#maxfee').val());
    };
  });
  </script>
<% include ../common/footer %>