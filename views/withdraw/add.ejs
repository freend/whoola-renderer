<!DOCTYPE html>
<script type="text/javascript">
document.addEventListener("DOMContentLoaded", function(){
    var token = localStorage.getItem('token');
    document.getElementById('token').value = localStorage.getItem('token');
});
</script>
<html lang="en">
  <head>
    <% include ../common/head %>
  </head>
  <body>
  <% include ../common/navi %>
    <div class="container">
        <div class="container">
            <form class="form" action="/withdraw" method="POST">
              <input type="hidden" value="" id="token" name="token">
              <input type="hidden" id="availAmount" value="<%= availAmount%>">
              <input type="hidden" id="totalAmount" value="<%= haveAmount%>">
              <div class="form-group">
                <label>Total : <%= haveAmount%></label>
                <label >Request Amount</label>
                
                <div class="input-group mb-3">
                  <div class="input-group-prepend">
                    <span class="input-group-text">$</span>
                    <span class="input-group-text"><%= availAmount %></span>
                  </div>
                  <input type="number" numberOnly class="form-control"
                  aria-label="Amount (to the nearest dollar)" id="amount" name="amount" value="0">
                </div>

                <label >Withdraw Account</label>
                <input type="text" class="form-control" id="account" name="account" >
              <div/>
              <div class="form-group">
                <button type="submit" class="btn btn-info">Add</button>
              </div>
            </form>
        </div>
    </div>
  </body>
</html>
<script>
  function back() {
      history.back();
  }
  $('#amount').on("propertychange change keyup paste input", function() {
    $(this).val($(this).val().replace(/[^0-9]/g,''));
  
    if ($(this).val() > $('#availAmount').val()) {
      $(this).val($('#availAmount').val());
    };
  });
  </script>
<% include ../common/footer %>