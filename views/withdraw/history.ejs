<!DOCTYPE html>
<html>
<head>
    <% include ../common/header %>
</head>

<body>
    <% include ../common/navigator %>
    <section>
        <h1 class="title">
            Withdrawal History
        </h1>
        <div class="conts_wrap">
            <div class="purchase_wrap">

                <div class="purchaseH mt_50">
                    <table class="type02">
                        <caption class="blind">Purchase update delete table</caption>
                        <thead>
                            <thead>
                                <td> State </td>
                                <td> Amount </td>
                                <td> Fee </td>
                                <td> Message </td>
                                <td> Create </td>
                                <td> Response </td>
                            </thead>
                            <% for (var i = 0; i < page.content.length; i++) { %>
                                <tr>
                                    <td><%= page.content[i].withdrawState %></td>
                                    <td> USD <%= (page.content[i].amount / 100) %></td>
                                    <td><%= (page.content[i].fee / 100) %></td>
                                    <td><%= page.content[i].content %></td>
                                    <td><%= page.content[i].createAt %></td>
                                    <td><%= page.content[i].responseAt %></td>
                                </tr>
                            <% } %>
                    </table>
                    <% include ../common/page %>
                </div>

            </div>
        </div>
    </section>
    <footer>
        <% include ../common/footers %>
    </footer>
</body>
</html>