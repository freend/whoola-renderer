<!DOCTYPE html>
<html>
<head>
    <% include ../common/header %>
</head>

<body>
    <header>
        <% include ../common/navigator %>
    </header>
    <section>
        <h1 class="title">
            <%= __('withdraw_1_1') %>
        </h1>
        <div class="conts_wrap">
            <div class="purchase_wrap">

                <div class="purchaseH mt_50">
                    <table class="type03">
                        <caption class="blind"><%= __('withdraw_1_2') %></caption>
                        <colgroup>
                            <col style="width: 20%">
                            <col style="width: auto">
                            <col style="width: 10%">
                            <col style="width: auto">
                            <col style="width: auto">
                            <col style="width: 15%">
                        </colgroup>
                        <thead>
                            <tr>
                                <th class="txt_c"><%= __('withdraw_1_3') %></th>
                                <th><%= __('withdraw_1_4') %></th>
                                <th><%= __('withdraw_1_5') %></th>
                                <th><%= __('withdraw_1_6') %></th>
                                <th><%= __('withdraw_1_7') %></th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            <% for (var i = 0; i < page.content.length; i++) { %>
                            <tr>
                                <td>
                                <% switch (page.content[i].withdrawState) {
                                    case "REQUESTED" :%>
                                    <p class="dots_wrap">
                                        <span class="dot"></span>
                                        <span class="dot"></span>
                                        <span class="dot"></span>
                                    </p>
                                    <span class="color_p"><%= __('withdraw_1_8') %></span>
                                    <%  break; 
                                        case "REQUEST_CONFIRMED":%>
                                    <p class="dots_wrap">
                                        <span class="dotA"></span>
                                        <span class="dot"></span>
                                        <span class="dot"></span>
                                    </p>
                                    <span class="color_p"><%= __('withdraw_1_9') %></span>
                                    <% break;
                                        case "ACCEPTED":%>
                                    <p class="dots_wrap">
                                        <span class="dotA"></span>
                                        <span class="dotA"></span>
                                        <span class="dot"></span>
                                    </p>
                                    <span class="color_p"><%= __('withdraw_1_10') %></span>
                                <%  break;
                                    case "CANCELED":%>
                                    <p class="dots_wrap">
                                        <span class="dotB"></span>
                                        <span class="dotB"></span>
                                        <span class="dotB"></span>
                                    </p>
                                    <span class="color_o"><%= __('withdraw_1_11') %></span>
                                <%  break;
                                    case "REJECTED":%>
                                    <p class="dots_wrap">
                                        <span class="dotA"></span>
                                        <span class="dotB"></span>
                                        <span class="dot"></span>
                                    </p>
                                    <span class="color_o"><%= __('withdraw_1_12') %></span>
                                <%  break;
                                    case "COMPLETE":%>
                                    <p class="dots_wrap">
                                        <span class="dotA"></span>
                                        <span class="dotA"></span>
                                        <span class="dotA"></span>
                                    </p>
                                    <span><%= __('withdraw_1_13') %></span>
                                <%  break;
                                } %>
                                </td>
                                <td><%= (page.content[i].amount / 100) %></td>
                                <td><%= (page.content[i].fee / 100) %></td>
                                <td><%= page.content[i].createAt %></td>
                                <td><%= page.content[i].responseAt %></td>
                                <% if (page.content[i].withdrawState == "REQUESTED" || page.content[i].withdrawState == "REQUEST_CONFIRMED") { %>
                                    <td><button class="btn_submit" onclick="cancelPopup('<%= page.content[i].id %>', '<%= page.content[i].createAt %>', '<%= page.content[i].amount / 100 %>')"><%= __('withdraw_1_14') %></button></td>
                                <% } else { %>
                                    <td><button class="btn_done"><%= __('withdraw_1_15') %></button></td>
                                <% } %>
                            </tr>
                            <% } %>
                        </tbody>
                    </table>
                    <% include ../common/page %>
                </div>

            </div>
        </div>
        <div class="conts_pop" style="display: none">
            <div class="pop_wrap" style="">
                <h1><%= __('withdraw_1_16') %></h1>
                <p id="cancelTitle"></p>
                <p class="bold"><%= __('withdraw_1_17') %></p>
                <div class="btn_group">
                    <button class="btn_submit" onclick="requestCancel()"><%= __('withdraw_1_18') %></button>
                    <button class="btn_done" onclick="closePopup()"><%= __('withdraw_1_19') %></button>
                </div>
            </div>
        </div>
    </section>
    <footer>
        <% include ../common/footers %>
    </footer>
    <script src="/static/javascripts/withdraw.js"></script>
    <script>
    var withdrawId = 0;
    function requestCancel() {
        console.log(withdrawId);
        location.href = '/withdraw/cancel?id=' + withdrawId + '&token=' + localStorage.getItem('token');
    }
    function cancelPopup(id, createAt, amount) {
        withdrawId = id;
        $('#cancelTitle').text("As to the $" + amount + " withdrawal request submitted " + createAt + ",");
        $('.conts_pop').css("display", 'block');
    }
    function closePopup() {
        $('.conts_pop').css("display", 'none');
    }
    </script>
</body>
</html>