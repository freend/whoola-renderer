<!DOCTYPE html>
<script type="text/javascript">
document.addEventListener("DOMContentLoaded", function(){
    var token = localStorage.getItem('token');
    document.getElementById('token').value = localStorage.getItem('token');
});
</script>
<html lang="en">
  <head>
    <% include ../common/head %>
  </head>
  <body>
  <% include ../common/navi %>
    <div class="container">
        <table class="table table-striped">
            <thead>
                <td> invite mail address </td>
                <td> invite mail sign up result </td>
            </thead>
            <% for (var i = 0; i < page.content.length; i++) { %>
                <tr>
                    <td><%= page.content[i].invitedUserMail %></td>
                    <% if(page.content[i].inviteResult == null) {%>
                        <td>Not Sign Up</td>
                    <% } else {%>
                        <td>Sign Up</td>
                    <% } %>
                </tr>
            <% } %>
        </table>
        <% if (page.content.length != 0) {%>
            <% include ../common/pagenation %>
        <% } %>
        <% include ../invite/add %>
    </div>
  </body>
</html>
<% include common/footer %>