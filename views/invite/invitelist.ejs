<div class="purchaseH mt_50">
    <table class="type02">
        <caption class="blind">Purchase update delete table</caption>
        <thead>
            <tr>
                <th>E-mail Address</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            <% for (var i = 0; i < page.content.length; i++) { %>
            <tr>
                <td><%= page.content[i].invitedUserMail %></td>
                <% if(page.content[i].inviteResult == null) {%>
                    <td>Not Signed Up</td>
                <% } else {%>
                    <td>Sign Up</td>
                <% } %>
            </tr>
            <% } %>
        </tbody>
    </table>
    <% include ../common/page %>
</div>