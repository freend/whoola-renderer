<!DOCTYPE html>
<html>
  <head>
    <% include ../common/header %>
</head>
<body>
  <% include ../common/navigator %>
  <script src="/static/javascripts/validate.js"></script>
    <section>
        <h1 class="title">Invite</h1>
        <form class="form" action="/invite/add" method="POST" id="form-submit">
          <input type="hidden" value="<%= token%>" id="token" name="token">
          <div class="conts_wrap">
              <div class="login_wrap">
                  <div class="login_email">
                      <h2>Invite E-mail Address</h2>
                      <div class="input_box">
                          <input type="text" id="mail" name="mail">
                      </div>
                      <button class="btn_login" type="button" onclick="requestCheck()">Ok</button>
                  </div>
                  <div>
                    <% include invitelist %>
                  </div>
              </div>
          </div>
        </form>
    </section>
  <footer>
      <% include ../common/footers %>
  </footer>
  <script>
    function requestCheck() {
      const mail = $('#mail').val();
      if (!validateMail(mail)) {
        alert('do not match email');
        return false;
      }
      const result = confirm("Would you like to send an invitation email to " + mail);
      if(result){
        $('#form-submit').submit();
      }else{
          alert("Your invitation email was cancelled and did not send.");
      }
    }
  </script>
</body>

</html>