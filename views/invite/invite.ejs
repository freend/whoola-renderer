<!DOCTYPE html>
<html>
  <head>
    <% include ../common/header %>
</head>
<body>
<% include ../common/googletag %>
  <header>
        <% include ../common/navigator %>
    </header>
  <script src="/static/javascripts/validate.js"></script>
    <section>
        <h1 class="title">Invite Friends</h1>
        <h2 class="sub_title">
<!--          Today Invited : <%= invited %> / Total : <%= total %>-->
      </h2>
        <form class="form" action="/invite/add" method="POST" id="form-submit">
          <input type="hidden" value="<%= token%>" id="token" name="token">
          <div class="conts_wrap">
              <div class="login_wrap">
                  <div class="login_email">
                      <h2>Enter the email address of the person you want to invite.</h2>
                      <div class="input_box">
                          <input type="text" id="mail" name="mail">
                      </div>
                      <button class="btn_login" type="button" onclick="requestCheck()">Send</button>
                  </div>
                  <div>
                    <% include invitelist %>
                  </div>
              </div>
          </div>
        </form>
    </section>
  <footer>
      <% include ../common/footers %>
  </footer>
  <script>
    const total = 100;
    const invited = <%= invited %>;
    
    function requestCheck() {
      const mail = $('#mail').val();
      if (!validateMail(mail)) {
        alert('Invalid Email Address');
        return false;
      }
        const result = confirm("Would you like to send an invitation email to " + mail);
        if(result){
            $('#form-submit').submit();
        }else{
            alert("Your invitation email was canceled and was not sent.");
        }
    }
    window.onload = function() {
        ableMailSend();
    }
    function ableMailSend() {
      if (invited >= total) {
        alert('You have exceeded the daily limit for sending invitations.');
        return false;
      } else {
        return true;
      }
    }
  </script>
</body>

</html>