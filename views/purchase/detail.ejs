<!DOCTYPE html>
<script type="text/javascript">
document.addEventListener("DOMContentLoaded", function(){
    var token = localStorage.getItem('token');
    document.getElementById('token').value = localStorage.getItem('token');
});
</script>
<html lang="en">
  <head>
    <% include ../common/head %>
    <link rel="stylesheet" href="/stylesheets/step.css">
  </head>
  <body>
  <% include ../common/navi %>
    <div class="container">
        <input type="hidden" value="" id="token" name="token">
        <input type="hidden" value="<%= amount%>" id="amount">
        <input type="hidden" value="<%= receiverId%>" name="receiver">
        <input type="hidden" value="<%= productId%>" name="productId">
        <input type="hidden" value="<%= totalPoint %>" name="totalPoint">
        <div class="container my-3">
            <h1 class="display-2 text-center mb-3">PURCHASE STEP</h1>
            <div class="row">
                <div class="col">
                </div>
                <div class="col-12">
                  <ul id="progressbar" class="text-center">
                      <li class="active" id="step1"><div class="d-none d-md-block">STEP 1</div></li>
                      <li class="active" id="step2"><div class="d-none d-md-block">STEP 2</div></li>
                      <li class="active" id="step3"><div class="d-none d-md-block">STEP 3</div></li>
                  </ul>
                </div>
              <div class="col">
             </div>
           </div>
        <label>name : <%= name%></label>
        <br>
        <label>phone number : </label> <label id="receiver"> <%= receiverPhone %> </label>
        <br>
        <label>operator : <%= operator %></label>
        <br>
        <label>product name : <%= productName%></label>
        <br>
        <label>Price : USD</label> <label id="viewAmount"> <%= amount%></label>
        <br>
        <label>Total Point : <%= totalPoint %></label>
         <label> Max Fee : </label> <label> <%= maxFee %></label>
        <br>
        <label> use Point</label>
        <div class="input-group mb-3">
          <div class="input-group-prepend">
            <span class="input-group-text">$</span>
            <span class="input-group-text"><%= ablePoint%></span>
          </div>
          <input type="number" numberOnly class="form-control" aria-label="Amount (to the nearest dollar)" id="usePoint"
          value="0">
        </div>
        <label> Use Fee : </label> <label id="useFee"> 0</label>
        <!--  https://www.paypal.com/cgi-bin/webscr -->
        <input type="hidden" id="availPoint" value="<%= ablePoint %>">
        <form action="<%= paypalUrl %>" method="post">
             <input type="hidden" name="cmd" value="_xclick">
             <input type="hidden" name="business" value="<%= paypalId %>">
             <input type="hidden" readonly name="item_name" value="<%= productName%>"> <br>
             <input type="hidden" readonly name="item_number" value="<%= productId%>"> <br>
             <input type="hidden" readonly name="currency_code" value="USD"> <br>
             <input type="hidden" readonly id="submitAmount" name="amount" value="<%= amount%>"> <br>
             <!-- 여기에 Referral Code를 넣어주도록 하자 -->
             <input type="hidden" name="custom" value="code:<%= referralCode %>,receiver:<%= receiverPhone %>">
             <input type="hidden" name="charset" value="UTF-8">
             <input type="image" name="submit" border="0" id="paypalBtn"
            src="https://www.paypalobjects.com/en_US/i/btn/btn_buynow_LG.gif"
            alt="PayPal - The safer, easier way to pay online">
            <button type="button" class="btn btn-danger" onClick="buyPoint()" id="pointBtn">Buy Point</button>
         </form>
         <br>
    </div>
  </body>
</html>
<% include ../common/footer %>
<script>
$(document).ready(function(){
    $('#pointBtn').hide();
});
$('#usePoint').on("propertychange change keyup paste input", function() {
  $(this).val($(this).val().replace(/[^0-9]/g,''));

  if ($(this).val() >= $('#availPoint').val()) {
    $(this).val($('#availPoint').val());
    $('input[name=submit]').hide();
    $('#pointBtn').show();
  } else {
    $('input[name=submit]').show();
    $('#pointBtn').hide();
  }
  $('#submitAmount').val($('#amount').val() - $(this).val());
  $('#viewAmount').text($('#submitAmount').val());
  $('#viewPoint').text($(this).val());
  $('#useFee').text(parseInt(($(this).val() * 100) * 0.05) / 100);
});
function buyPoint() {
        var form = document.createElement('form');
        form.setAttribute('method', 'POST');
        form.setAttribute('action', '/purchase');
        document.charset = "utf-8";

        var receiverField = document.createElement('input');
        receiverField.setAttribute('type', 'hidden');
        receiverField.setAttribute('name', 'receiver');
        receiverField.setAttribute('value', $('input[name=receiver]').val());
        form.appendChild(receiverField);

        var productField = document.createElement('input');
        productField.setAttribute('type', 'hidden');
        productField.setAttribute('name', 'productId');
        productField.setAttribute('value', $('input[name=productId]').val());
        form.appendChild(productField);

        var tokenField = document.createElement('input');
        tokenField.setAttribute('type', 'hidden');
        tokenField.setAttribute('name', 'token');
        tokenField.setAttribute('value', localStorage.getItem('token'));
        form.appendChild(tokenField);
        document.body.appendChild(form);

        form.submit();
    }
</script>