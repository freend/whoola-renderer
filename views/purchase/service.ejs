<!DOCTYPE html>
<html>
<head>
    <% include ../common/header %>
</head>
<body>
    <header>
        <% include ../common/navigator %>
    </header>
    <section>
        <h1 class="title">
            <span><b><%= __('purchase_2_1') %></b> <%= __('purchase_2_2') %></span>
            <%= __('purchase_2_3') %>
            <span><b><%= __('purchase_2_4') %></b> <%= __('purchase_2_5') %></span>
        </h1>
        <div class="conts_wrap">
            <input type="hidden" value="" id="token" name="token">
            <input type="hidden" value="<%= receiver%>" name="receiver" id="receiver">
            <input type="hidden" value="<%= isoCode%>" name="isoCode" id="isoCode">
            <div class="ssc_wrap">
                <div class="ssc_box" id="serviceBtn-1">
                    <div class="iconsBox"><span class="blind"><%= __('purchase_2_6') %></span></div>
                    <div class="ssc_txt">
                        <p><%= __('purchase_2_7') %></p>
                    </div>
                </div>
                
                <div class="ssc_box" id="serviceBtn-2">
                    <div class="iconsBox"><span class="blind"><%= __('purchase_2_8') %></span></div>
                    <div class="ssc_txt">
                        <p><%= __('purchase_2_9') %></p>
                    </div>
                </div>
                
                <div class="ssc_box" id="serviceBtn-6">
                    <div class="iconsBox"><span class="blind"><%= __('purchase_2_10') %></span></div>
                    <div class="ssc_txt">
                        <p><%= __('purchase_2_11') %></p>
                    </div>
                </div>
                
                <div class="ssc_box" id="serviceBtn-5">
                    <div class="iconsBox"><span class="blind"><%= __('purchase_2_12') %></span></div>
                    <div class="ssc_txt">
                        <p><%= __('purchase_2_13') %></p>
                    </div>
                </div>
                
                <div class="ssc_box" id="serviceBtn-4">
                    <div class="iconsBox"><span class="blind"><%= __('purchase_2_14') %></span></div>
                    <div class="ssc_txt">
                        <p><%= __('purchase_2_15') %></p>
                    </div>
                </div>
                
                 <div class="ssc_box" id="serviceBtn-3">
                    <div class="iconsBox"><span class="blind"><%= __('purchase_2_16') %></span></div>
                    <div class="ssc_txt">
                        <p><%= __('purchase_2_17') %></p>
                    </div>
                </div>
                
                 <div class="ssc_box" id="serviceBtn-9">
                    <div class="iconsBox"><span class="blind">voip</span></div>
                    <div class="ssc_txt">
                        <p>VoIP</p>
                    </div>
                </div>
                

            </div>
        </div>
    </section>

    <footer>
        <% include ../common/footers %>
    </footer>


</body>
<script>
    function serviceList(serviceId) {
        location.href = '/service/operator?receiver=' + $('#receiver').val()
         + '&service=' + serviceId
         + '&isoCode=' + $('#isoCode').val()
         + '&token=' + $('#token').val();
    }
    window.onload = function() {
        $('.ssc_box').css('display', 'none');
        const service = [<%= service %>];
        for (i = 0; i < service.length; i++) {
            if (service[i] != 1) {
                $('#serviceBtn-' + service[i]).css('display', 'block');
            }
        }
        for (var i = 0; i <= 9; i++) {
            $('#serviceBtn-' + i).click(function(){
                const serviceId = $(this).attr('id').split('-')[1];
                serviceList(serviceId);
            });
        }
    }
    </script>
</html>