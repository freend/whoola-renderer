<!DOCTYPE html>
<html lang="en">
  <head>
    <% include ../common/head %>
  </head>
  <script>
  function c_copy(){
    var copyText = document.getElementById("link");
      copyText.select();
      document.execCommand("Copy");
  }
  </script>
  <body>
  <% include ../common/navi %>
    <div class="container">
    <form>
          <div class="form-group">
                <input type="hidden" value="" id="token" name="token">
                name : <input type="text", class="form-control" value=<%= mail%> readonly>
                Referral Code : <input type="text", class="form-control" value=<%= myReferralCode %> readonly>
                point : <input type="text", class="form-control" value=<%= point %> readonly>
                 <br>
                 <div class="col-lg-6">
                     <div class="input-group">
                       <input type="text" class="form-control" value="<%= link %>" id="link">
                       <span class="input-group-btn">
                         <button class="btn btn-default" type="button" onclick="c_copy()">Copy</button>
                       </span>
                     </div><!-- /input-group -->
                   </div><!-- /.col-lg-6 -->
                 </div><!-- /.row -->
                 <br>
          </div>
        </form>
    </div>
  </body>
</html>
<% include common/footer %>