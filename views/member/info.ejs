<!DOCTYPE html>
<html lang="en">
  <head>
    <% include ../common/head %>
  </head>
  <body>
  <% include ../common/navi %>
    <div class="container">
          <div class="form-group">
                <input type="hidden" value="" id="token" name="token">
                Email : <input type="text", class="form-control" value="<%= mail%>" readonly>
                Referral Code : <input type="text", class="form-control" value="<%= myReferralCode %>" readonly>
                Buy This Month : <input type="text", class="form-control" value="<%= buyThisMonth %>" readonly>
                point : <input type="text", class="form-control" value="<%= point %>" readonly>
                Pay pal Account : <input type="text", class="form-control" value="<%= paypal %>" readonly>
                Business level : <input type="text", class="form-control" value="" id="businessLevel" readonly>
                <% if(paypal == null) {%>
                <br>
                <button type="button" class="btn btn-success" onClick="setToken('/users/paypal?token=')">Add Pay Pal Account</button>
                <% } %>
                 <br>
                 <label>Link</label>
                 <div class="col-lg-7">
                     <div class="input-group">
                       <input type="text" readonly class="form-control form-control-plaintext" value="<%= link %>" id="link">
                       <span class="input-group-btn">
                         <button class="btn btn-default" type="button btn-secondary" onclick="c_copy()">Copy</button>
                       </span>
                     </div><!-- /input-group -->
                   </div><!-- /.col-lg-6 -->
                 </div><!-- /.row -->
                 <br>
                 <button type="button" href="#" class="btn btn-success" onClick="setToken('/users/password?token=')">Change Password</button>
          </div>
    </div>
  </body>
</html>
<script>
function c_copy(){
  var copyText = document.getElementById("link");
    copyText.select();
    document.execCommand("Copy");
}
window.onload = function() {
    const text = "name : <%= level.name %>, 1 level HM dollar percent : <%= level.oneLevelPercent %>%, "
    + "2 level HM dollar percent : <%= level.twoLevelPercent %>%"
    $('#businessLevel').val(text);
};
function setToken(value) {
	location.href = value + localStorage.getItem('token');
}
</script>
<% include ../common/footer %>