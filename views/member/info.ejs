<!DOCTYPE html>
<html lang="en">
  <head>
    <% include ../common/head %>
  </head>
  <body>
  <% include ../common/navi %>
    <div class="container">
          <div class="form-group">
                <input type="hidden" value="" id="token" name="token">
                name : <input type="text", class="form-control" value="<%= mail%>" readonly>
                Referral Code : <input type="text", class="form-control" value="<%= myReferralCode %>" readonly>
                point : <input type="text", class="form-control" value="<%= point %>" readonly>
                paypal : <input type="text", class="form-control" value="<%= paypal %>" readonly>
                <% if(paypal == null) {%>
                <br>
                <button type="button" class="btn btn-success">Add Pay Pal Account</button>
                <% } %>
                 <br>
                 <label>Link</label>
                 <div class="col-lg-7">
                     <div class="input-group">
                       <input type="text" readonly class="form-control form-control-plaintext" value="<%= link %>" id="link">
                       <span class="input-group-btn">
                         <button class="btn btn-default" type="button btn-secondary" onclick="c_copy()">Copy</button>
                       </span>
                     </div><!-- /input-group -->
                   </div><!-- /.col-lg-6 -->
                 </div><!-- /.row -->
                 <br>
          </div>
    </div>
  </body>
</html>
<script>
function c_copy(){
  var copyText = document.getElementById("link");
    copyText.select();
    document.execCommand("Copy");
}
</script>
<% include ../common/footer %>