<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title>Hoola Moolah</title>
    <% include ../common/head %>
    <script type="text/javascript" src="/javascripts/validate.js"></script>
    <!-- Favicons -->
    <link rel="apple-touch-icon" href="/docs/4.4/assets/img/favicons/apple-touch-icon.png" sizes="180x180">
    <link rel="icon" href="/docs/4.4/assets/img/favicons/favicon-32x32.png" sizes="32x32" type="image/png">
    <link rel="icon" href="/docs/4.4/assets/img/favicons/favicon-16x16.png" sizes="16x16" type="image/png">
    <link rel="mask-icon" href="/docs/4.4/assets/img/favicons/safari-pinned-tab.svg" color="#563d7c">
    <link rel="icon" href="/docs/4.4/assets/img/favicons/favicon.ico">
    <meta name="theme-color" content="#563d7c">
    <style>
      .bd-placeholder-img {
        font-size: 1.125rem;
        text-anchor: middle;
        -webkit-user-select: none;
        -moz-user-select: none;
        -ms-user-select: none;
        user-select: none;
      }

      @media (min-width: 768px) {
        .bd-placeholder-img-lg {
          font-size: 3.5rem;
        }
      }
    </style>
    <!-- Custom styles for this template -->
    <link href="/stylesheets/signin.css" rel="stylesheet">
  </head>
  <body class="text-center">
    <form class="form-signin" action="/signup" method=POST id="submit-form">
      <img class="mb-4" src="https://getbootstrap.com/docs/4.4/assets/brand/bootstrap-solid.svg" alt="" width="72" height="72">
      <h1 class="h3 mb-3 font-weight-normal">Please sign up</h1>
      <label for="inputEmail" class="sr-only">Email address</label>
      <input type="email" id="inputEmail" class="form-control" placeholder="Email address" name="id" required autofocus>
      <label for="inputPassword" class="sr-only">Password</label>
      <input type="password" id="password" class="form-control" placeholder="Password" name="password" required>
      <label for="inputPassword" class="sr-only">Password check</label>
      <input type="password" id="password-check" class="form-control" placeholder="Password again" name="password-confirm" required>
      <label id="match">Check password</label>
      <div class="form-group">
        <label for="inputReferral">Referral Code</label>
        <% if (referralCode == null) { %>
            <input type="text" id="inputReferral" name="referralCode" class="form-control" placeholder="Referral Code" style="ime-mode:disabled">
        <% } else { %>
            <input type="text" value="<%= referralCode %>" id="inputReferral" name="referralCode" class="form-control" readonly>
        <% } %>
      </div>
      <div class="form-group">
          <!-- Button trigger modal -->
          <input type="checkbox" class="form-check-input" id="checkContract" required>
          <button type="button" class="btn btn-success" data-toggle="modal" data-target="#exampleModalScrollable">
            Contract
          </button>
      </div>
      <button class="btn btn-lg btn-primary btn-block" type="button" id="btnSubmit">Sign Up</button>
      <button class="btn btn-lg btn-info btn-block" type="button" href="#" onclick="location.href = '/signin'">Sign In</button>
      <p class="mt-5 mb-3 text-muted">&copy; 2020</p>
    </form>
    <% include contract %>
  </body>
</html>
<script>
  $('#btnSubmit').click(function(event){
    $(this).attr('disabled', true);
    const chkContract = $('#checkContract');
    const mail = $('#inputEmail');
    const pass = $('#password');
    const passCheck = $('#password-check');
    const match = $('#match');

    if (chkContract.is(":checked") == false) {
      alert('agree contract');
      chkContract.focus();
      $(this).attr('disabled', false);
      return false;
    }
    if (!validateMail(mail.val())) {
      alert('do not match email');
      $(this).attr('disabled', false);
      return false;
    }
    if (pass.val() == '') {
      alert('password required');
      $(this).attr('disabled', false);
      return false;
    }
    if (passCheck.val() == '') {
      alert('password check required');
      $(this).attr('disabled', false);
      return false;
    }
    if (match.text() != 'correct') {
      alert('password not match');
      $(this).attr('disabled', false);
      return false;
    }
    $('#submit-form').submit();
  });

  $('#agreeContract').click(function(event) {
    $('#checkContract').attr("checked", true);
  });

  $('#password-check').keyup(function (event) {
    var match = $('#match');
    var pass = $('#password');
    var confirm = $('#password-check');
    if (pass.val() == confirm.val()) {
      match.css("color", 'blue');
      match.text('correct');
    } else {
      match.css("color", 'red');
      match.text('not correct');
    }
  });
</script>
<% include ../common/footer %>