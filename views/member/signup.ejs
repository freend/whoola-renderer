<!DOCTYPE html>
<html lang="en">
  <head>
    <% include ../common/head %>
  </head>

  <body>
    <% include ../common/navi %>
    <div class="container">

      <form class="form-signup" action="/signup" method=POST>
        <h2 class="form-signin-heading">Please sign up</h2>
        <label for="inputEmail" class="sr-only">Email address</label>
        <input type="email" id="inputEmail" name="id" class="form-control" placeholder="Email address" required autofocus>
        <label for="inputPassword" class="sr-only">Password</label>
        <input type="password" id="inputPassword" name="password" class="form-control" placeholder="Password" required>
        <label class="sr-only">Referral Code</label>
        <input type="text" id="inputReferral" name="referralCode" class="form-control" placeholder="Referral Code">
        <button class="btn btn-lg btn-primary btn-block" type="submit">Sign Up</button>
      </form>

    </div> <!-- /container -->


    <!-- IE10 viewport hack for Surface/desktop Windows 8 bug -->
    <script src="../../assets/js/ie10-viewport-bug-workaround.js"></script>
  </body>
</html>
