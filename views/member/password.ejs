<!DOCTYPE html>
<html lang="en">
  <head>
    <% include ../common/head %>
    <title>Reset Password</title>
  </head>
  <body>
    <div class="container">
        <form class="form-signup" action="/validate/reset" method=POST>
          <div class="form-group">
                <input type="hidden" value="<%= validateCode%>" id="validateCode" name="validateCode">
                <input type="hidden" value="<%= mail%>" id="mail" name="mail">
                <label for="inputPassword" class="sr-only">Password</label>
                <input type="password" id="password" name="password" class="form-control" placeholder="Password" required>
                <label for="inputPassword" class="sr-only">Password Check</label>
                <input type="password" id="password-check" name="password-confirm" class="form-control" placeholder="Password again" required>
                <label id="match">Check password</label>
                <button class="btn btn-lg btn-primary btn-block" type="submit">Reset Password</button>
          </div>
        </form>
    </div>
  </body>
</html>
<script>
$('#password-check').keyup(function (event) {
    var match = $('#match');
    var pass = $('#password');
    var confirm = $('#password-check');
    if (pass.val() == confirm.val()) {
    match.css("color", 'blue');
    match.text('correct');
    } else {
    match.css("color", 'red');
    match.text('not correct');
    }
});
</script>
<% include ../common/footer %>