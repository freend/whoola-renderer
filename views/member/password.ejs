<!DOCTYPE html>
<html>
<head>
    <% include ../common/header %>
</head>
<body>
<% include ../common/googletag %>
    <% if(flag == true) { %>
      <header>
        <% include ../common/navigator %>
    </header>
      <section>
        <h1 class="title">Change Password</h1>
        <div class="conts_wrap">
            <form class="form-signin" action="/users/password" method=POST id="submit-form">
              <input type="hidden" id="token" name="token" value="<%= token %>">
              <div class="login_wrap">
                  <div class="login_email">
                      <h2>Current Password</h2>
                      <div class="input_box">
                          <input type="password" id="currentPassword" name="currentPassword">
                      </div>
                      <h2>New Password</h2>
                      <div class="input_box">
                          <input type="password" id="password" name="password">
                      </div>
                      <h2>Confirm Your New Password</h2>
                      <div class="input_box">
                          <input type="password" id="password-check" name="password-confirm">
                          <small id="match">Please Re-enter The New Password.</small>
                      </div>
                      <button class="btn_login" type="button" id="btnSubmit">Change Password</button>
                  </div>
              </div>
            </form>
        </div>
    </section>
    <script>
      function setToken(value) {
          location.href = value + localStorage.getItem('token');
      }
    </script>

    <footer>
        <% include ../common/footers %>
    </footer>
    <% } else { %>
      <div class="container">
        <form class="form-signin" action="/validate/reset" method=POST id="submit-form">
          <input type="hidden" value="<%= validateCode%>" id="validateCode" name="validateCode">
          <input type="hidden" value="<%= mail%>" id="mail" name="mail">
          <div class="login_wrap">
            <div class="login_email">
                <h2>New Password</h2>
                <div class="input_box">
                    <input type="password" id="password" name="password">
                </div>
                <h2>Confirm Your New Password</h2>
                <div class="input_box">
                    <input type="password" id="password-check" name="password-confirm">
                    <small id="match">Please Re-enter The New Password.</small>
                </div>
                <button class="btn_login" type="button" id="btnSubmit">Reset Password</button>
            </div>
          </div>
        </form>
    </div>
    <% } %>
    <script>
      $('#password-check').keyup(function (event) {
        var match = $('#match');
        var pass = $('#password');
        var confirm = $('#password-check');
        if (pass.val() == confirm.val()) {
          match.css("color", 'blue');
          match.text('Passwords Matched!');;
        } else {
          match.css("color", 'red');
          match.text('Passwords Do Not Match! Please Try Again.');
        }
      });
      $('#btnSubmit').click(function (event) {
        var pass = $('#password');
        var confirm = $('#password-check');
        if ($('#currentPassword').val() == '') {
          alert('Please Enter Your Current Password');
          return false;
        }
        if (pass.val() != confirm.val()) {
          alert('Incorrect Password! Please Try Again');
          return false;
        }
        $('#submit-form').submit();

      });
    </script>
    <% include ../common/footers %>
  </body>
</html>