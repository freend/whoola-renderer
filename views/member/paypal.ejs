                    </div>
                    
                    <p class="mt_50">HoolaMoolah does not take any responsibility for any incorrect input of account details.<br>
                        Please double check your account details before registering.</p>
                    
                    <button class="btn_login" type="button">Ok</button>
                </div>
                
