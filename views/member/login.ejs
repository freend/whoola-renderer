<!DOCTYPE html>
<html>
<head>
    <script>
        localStorage.removeItem('token');
    </script>
    <% include ../common/header %>
    <script src="/static/javascripts/validate.js"></script>
</head>
<body>
<% include ../common/googletag %>
    <header>
        <% include ../common/navigator %>
    </header>
    <section>
        <h1 class="title">Login</h1>
        <form class="form-signin" action="/login" method=POST>
            <div class="conts_wrap">
                <div class="login_wrap">
                    <div class="login_email">
                        <h2>Email Address</h2>
                        <div class="input_box">
                            <input type="email" name="id" id="inputEmail" required autofocus>
                        </div>
                        <h2>Password</h2>
                        <div class="input_box">
                            <input type="password" name="password" required>
                        </div>
                        <button class="btn_login" type="submit">Login</button>
                    </div>
                    <div class="or">
                        <p>or</p>
                    </div>
                    <div class="btn_group forget_sign">
                        <button id="forget-password" class="btn_forget" type="button">Forgot Password?</button>
                        <button href="#" onclick="location.href = '/signup'">Sign Up</button>
                    </div>
                </div>
            </div>
            <input type="hidden" name="url" value="<%= url %>">
        </form>
    </section>
    <script>
        $('#forget-password').click(function(){
          const mail = $('#inputEmail');
          if (mail.val() == '') {
            alert('Please Enter The Email Address You Used To Sign Up');
          } else if(!validateMail(mail.val())) {
            alert('Invalid Email Address');
          } else {
            $(location).attr('href', 'validate/password/' + mail.val());
          }
        });
    </script>

    <footer>
        <% include ../common/footers %>
    </footer>
</body>
</html>