<!DOCTYPE html>
<html>
<head>
    <% include ../common/header %>
</head>
<body>
    <header>
        <% include ../common/navigator %>
    </header>
    <section>
        <h1 class="title"><%= __('member_myinfo_1') %></h1>
        <div class="conts_wrap">
            <div class="myinfo_wrap">
                <div class="left">
                    <div class="box">
                        <h1>
                            <%= mail%>
                        </h1>
                        <dl>
                            <dt class="bold"><%= __('member_myinfo_2') %></dt>
                            <dd><img id="levelImg" src=""></dd>
                        </dl>
                        <dl>
                            <dt><%= __('member_myinfo_3') %></dt>
                            <dd class="bold" id="levelName"></dd>
                        </dl>
                        <dl>
                            <dt><%= __('member_myinfo_4') %></dt>
                            <dd class="bold" id="level1"></dd>
                        </dl>
                        <dl>
                            <dt><%= __('member_myinfo_5') %></dt>
                            <dd class="bold" id="level2"></dd>
                        </dl>
                    </div>
                </div>
                <div class="right">
                    <div class="box">
                       <dl>
                            <dt><%= __('member_myinfo_6') %></dt>
                            <dd class="bold">
                                <input type="text" id="code" value="<%= myReferralCode %>" readonly>
                                <a href="#" onclick="copyCode()"><img src="/static/images/icon_docu.png"></a>
                           </dd>
                        </dl>
                        <dl>
                            <dt><%= __('member_myinfo_7') %></dt>
                            <dd class="bold"><%= buyThisMonth %></dd>
                        </dl>
                        <dl>
                            <dt><%= __('member_myinfo_8') %></dt>
                            <dd class="bold"><%= point %> $</dd>
                        </dl>
                        <dl>
                            <dt><%= __('member_myinfo_9') %></dt>
                            <dd class="bold"><%= paypal %></dd>
                        </dl>
                        <dl>
                            <dt><%= __('member_myinfo_10') %></dt>
                            <dd class="bold">
                                <!-- <%= link %> -->
                                <input type="text" id="link" value="<%= link %>" readonly>
                                <a href="#" onClick="copyUrl();return false;"><img src="/static/images/icon_docu.png"></a>
                            </dd>
                        </dl>
                    </div>
                   <div class="btn_group">
                    <button class="btn_o btn_big" onClick="setToken('/users/paypal?token=')"><%= __('member_myinfo_11') %></button>
                    <button class="btn_big" onClick="setToken('/users/password?token=')"><%= __('member_myinfo_12') %></button>
                </div>
                </div>
            </div>
        </div>
    </section>
    <style type="text/css">
        input {
            font-weight:bold;
            border-top: none;
            border-right:none;
            border-left:none;
            border-bottom: none;
            margin-left: -10px;
            width: 300px;
        }
     </style>
    <script>
        function copyCode() {
            const copyText = document.getElementById("code");
            copyText.select();
            copyText.setSelectionRange(0, 99999);
            document.execCommand("Copy");
            alert('Copied');
        }
        function copyUrl() {
            const copyText = document.getElementById("link");
            copyText.select();
            copyText.setSelectionRange(0, 99999);
            document.execCommand("Copy");
            alert('Copied');
        }
        window.onload = function() {
            const name = "<%= level.name %>";
            const level1 = "<%= level.oneLevelPercent %>%";
            const level2 = "<%= level.twoLevelPercent %>%";
            $('#levelName').text(name);
            $('#level1').text(level1);
            $('#level2').text(level2);
            
            switch (name) {
                case 'Family':
                url = '/static/images/icon_family.png';
                break;
                case 'Premium':
                url = '/static/images/icon_premium.png';
                break;
                default:
                url = '/static/images/icon_user.png';
                break;
            }
            $('#levelImg').attr("src", url);
        };
        function setToken(value) {
            location.href = value + localStorage.getItem('token');
        }
    </script>

    <footer>
        <% include ../common/footers %>
    </footer>
</body>
</html>