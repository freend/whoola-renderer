<!DOCTYPE html>
<html>
<head>
    <% include ../common/header %>
    <script src="https://d1uvpyasv6rv5d.cloudfront.net/javascripts/validate.js"></script>
</head>
<body>
<% include ../common/googletag %>
    <header>
        <% include ../common/navigator %>
    </header>
    <section>
        <h1 class="title">hoolamoolah Sign Up</h1>
        <form action="/signup" method=POST id="submit-form">
            <div class="conts_wrap">
                <div class="signup_wrap">
                    <div class="left">
                        <div class="signup_input">
                        <h2>Email Address</h2>
                        <div class="input_box">
                            <% if (mail == undefined) { %>
                              <input type="email" id="inputEmail" name="id" autofocus>
                              <small id="emailText">Please Enter Your Email Address</small>
                            <% } else { %>
                              <input value="<%= mail %>" disabled>
                              <input type="hidden" id="inputEmail" name="id" value="<%= mail %>">
                            <% } %>
                        </div>
                        <h2>Password</h2>
                        <div class="input_box">
                            <input type="password" id="password" name="password">
                            <small></small>
                        </div>
                            <h2>Password Confirmation</h2>
                        <div class="input_box">
                            <input type="password" id="password-check" name="password-confirm">
                            <small id="match"></small>
                        </div>
                            <h2>Referral Code</h2>
                        <div class="input_box">
                            <% if (referralCode == null) { %>
                                <input type="text" id="inputReferral" name="referralCode" placeholder="Enter an invitation code to claim your HM 2$">
                            <% } else { %>
                                <input type="text" value="<%= referralCode %>" id="inputReferral" name="referralCode" readonly>
                            <% } %>
                        </div>
                    </div>
                    <div class="chk_wrap">
                        <input type="checkbox" id="term">
                        <label for="term">I agree to the hoolamoolah <a href="https://hoolamoolah.com/info/terms" target="_blank">Terms of Service</a>, <a href="https://hoolamoolah.com/info/privacy" target="_blank">Privacy Policy</a>, and <a href="https://hoolamoolah.com/info/cookie" target="_blank">Cookie Policy</a>.</label>
                    </div>
                    <div class="signup_info mt_50">
                        <p class="m_img"><img src="https://d1uvpyasv6rv5d.cloudfront.net/images/img15.png"></p>
                        <span class="titleA">One and Only<br>Industry Commission<br>Rebate Program</span>
                        <span class="w_img"><img src="https://d1uvpyasv6rv5d.cloudfront.net/images/img14.png"></span>
                    </div>
                    <div class="txt mt_20">
                      hoolamoolah offers the chance to make extra income for everyone by sharing the profits from our rewardable top-up service
                    </div>
                    <!--<div class="link">
                      <a href="/info/terms" target="_blank">Terms</a>
                      <a href="/info/privacy" target="_blank">Privacy</a>
                      <a href="/info/cookie" target="_blank">Cookie</a>
                    </div>
                    </div>
                    <div class="right">
                      <div class="signup_consumer">
                        <h1><img src="https://d1uvpyasv6rv5d.cloudfront.net/images/icon_user.png"> Consumer</h1>
                        <div>
                            <p>
                                <span>Requirements </span>
                                <span><b>None</b></span>
                            </p>
                             <p>
                                <span>Payback</span>
                                <span>
                                   <b class="color_p bold">3% of Purchase Amount on Tier 1 Customers</b>
                                 </span>
                            </p>
                        </div>
                    </div>
                      <div class="signup_premium">
                          <h1><img src="https://d1uvpyasv6rv5d.cloudfront.net/images/icon_premium.png"> Premium</h1>
                          <div>
                              <p>
                                  <span>Requirements </span>
                                  <span>Minimum monthly spending <b class="color_p">over $50</b></span>
                              </p>
                               <p>
                                  <span>Payback</span>
                                  <span>
                                     <b class="color_p bold">9% of Purchase Amount on Tier 1 Customers</b>
                                      <br>
                                     <b class="color_o">1% of Purchase Amount on Tier 2 Customers</b>
                                   </span>
                              </p>
                          </div>
                      </div>
                       <div class="signup_family">
                          <h1><img src="https://d1uvpyasv6rv5d.cloudfront.net/images/icon_family.png"> Family</h1>
                          <div>
                              <p>
                                  <span>Requirements </span>
                                  <span>
                                      Minimum monthly spending <b class="color_p">over $20</b>
                                  </span>
                              </p>
                               <p>
                                  <span>Payback</span>
                                  <span>
                                      <b class="color_p bold">5% of Purchase Amount on Tier 1 Customers</b><br>
                                      <b class="color_o">1% of Purchase Amount on Tier 2 Customers</b>
                                   </span>
                              </p>
                          </div>
                      </div>
                      <div class="cautions_box" style="width: 100%">
                          <p class="title">Note</p>
                          <p><span class="bold">*Tier 1</span> means Direct Customers <br>
                              <span class="bold">*Tier 2</span> means Direct customers of Tier 1 customer <br>
                              The monthly spending will be reset on the <span class="color_p">1st day of each month.</span></p>
                      </div>-->
                  </div>
                    <div class="btn_group">
                        <button class="btn_login" id="btnSubmit">Sign Up</button>
                    </div>
                </div>
            </div>
            <input type="hidden" name="url" value="<%= url %>">
        </form>
    </section>
    <footer>
        <% include ../common/footers %>
    </footer>
</body>
    <script>
    $('#btnSubmit').click(function(event){
      $(this).attr('disabled', true);
      const chkContract = $('#term');
      const mail = $('#inputEmail');
      const pass = $('#password');
      const passCheck = $('#password-check');
      const match = $('#match');
  
      if (chkContract.is(":checked") == false) {
        alert('Please Agree to the hoolamoolah Terms');
        chkContract.focus();
        $(this).attr('disabled', false);
        return false;
      }
      if (!validateMail(mail.val())) {
        alert('do not match email');
        $('#emailText').text('Invalid Email Address');
        $(this).attr('disabled', false);
        return false;
      } else {
        $('#emailText').text('Valid Email');
      }
      if (pass.val() == '') {
        alert('Password Is Required');
        $(this).attr('disabled', false);
        return false;
      }
      if (passCheck.val() == '') {
        alert('Please Confirm Your Password');
        $(this).attr('disabled', false);
        return false;
      }
      if (!validateText(pass.val(), passCheck.val())) {
        alert('Passwords Do Not Match');
        $(this).attr('disabled', false);
        return false;
      }
      $('#submit-form').submit();
    });
  
    $('#agreeContract').click(function(event) {
      $('#checkContract').attr("checked", true);
    });
  
    $('#password-check').keyup(function (event) {
      var match = $('#match');
      var pass = $('#password');
      var confirm = $('#password-check');
      if (pass.val() == confirm.val()) {
        match.css("color", 'blue');
        match.text('Passwords Matched!');;
      } else {
        match.css("color", 'red');
        match.text('Passwords Do Not Match');
      }
    });
  </script>
  <script src="https://d1uvpyasv6rv5d.cloudfront.net/javascripts/validate.js"></script>
</html>