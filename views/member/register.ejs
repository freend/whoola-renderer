<!DOCTYPE html>
<html>
<head>
    <% include ../common/header %>
    <script src="/static/javascripts/validate.js"></script>
</head>
<body>
    <header>
        <% include ../common/navigator %>
    </header>
    <section>
        <h1 class="title"><%= __('member_register_1') %></h1>
        <form action="/signup" method=POST id="submit-form">
            <div class="conts_wrap">
                <div class="signup_wrap">
                    <div class="left">
                        <div class="signup_input">
                        <h2><%= __('member_register_2') %></h2>
                        <div class="input_box">
                            <% if (mail == undefined) { %>
                              <input type="email" id="inputEmail" name="id" autofocus>
                              <small id="emailText"><%= __('member_register_3') %></small>
                            <% } else { %>
                              <input value="<%= mail %>" disabled>
                              <input type="hidden" id="inputEmail" name="id" value="<%= mail %>">
                            <% } %>
                        </div>
                        <h2><%= __('member_register_4') %></h2>
                        <div class="input_box">
                            <input type="password" id="password" name="password">
                            <small></small>
                        </div>
                            <h2><%= __('member_register_5') %></h2>
                        <div class="input_box">
                            <input type="password" id="password-check" name="password-confirm">
                            <small id="match"></small>
                        </div>
                            <h2><%= __('member_register_6') %></h2>
                        <div class="input_box">
                            <% if (referralCode == null) { %>
                                <input type="text" id="inputReferral" name="referralCode" placeholder="Enter an invitation code to claim your HM 2$">
                            <% } else { %>
                                <input type="text" value="<%= referralCode %>" id="inputReferral" name="referralCode" readonly>
                            <% } %>
                        </div>
                    </div>
                    <div class="chk_wrap">
                        <input type="checkbox" id="term">
                        <label for="term"><%= __('member_register_7') %></label>
                    </div>
                    <div class="signup_info mt_50">
                        <p class="m_img"><img src="/static/images/img15.png"></p>
                        <span class="titleA"><%= __('member_register_8') %><br><%= __('member_register_9') %><br><%= __('member_register_10') %></span>
                        <span class="w_img"><img src="/static/images/img14.png"></span>
                    </div>
                    <div class="txt mt_20">
                      <%= __('member_register_11') %>
                    </div>
                    <div class="link">
                      <a href="/info/terms" target="_blank"><%= __('member_register_12') %></a>
                      <a href="/info/privacy" target="_blank"><%= __('member_register_13') %></a>
                      <a href="/info/cookie" target="_blank"><%= __('member_register_14') %></a>
                    </div>
                    </div>
                    <div class="right">
                      <div class="signup_consumer">
                        <h1><img src="/static/images/icon_user.png"> <%= __('member_register_15') %></h1>
                        <div>
                            <p>
                                <span><%= __('member_register_16') %> </span>
                                <span><b><%= __('member_register_17') %></b></span>
                            </p>
                             <p>
                                <span><%= __('member_register_18') %></span>
                                <span>
                                   <b class="color_p bold"><%= __('member_register_19') %></b>
                                 </span>
                            </p>
                        </div>
                    </div>
                      <div class="signup_premium">
                          <h1><img src="/static/images/icon_premium.png"> <%= __('member_register_20') %></h1>
                          <div>
                              <p>
                                  <span><%= __('member_register_21') %> </span>
                                  <span><%= __('member_register_22') %> <b class="color_p"><%= __('member_register_23') %></b></span>
                              </p>
                               <p>
                                  <span><%= __('member_register_24') %></span>
                                  <span>
                                     <b class="color_p bold"><%= __('member_register_25') %></b>
                                      <br>
                                     <b class="color_o"><%= __('member_register_26') %></b>
                                   </span>
                              </p>
                          </div>
                      </div>
                       <div class="signup_family">
                          <h1><img src="/static/images/icon_family.png"> <%= __('member_register_27') %></h1>
                          <div>
                              <p>
                                  <span><%= __('member_register_28') %> </span>
                                  <span>
                                    <%= __('member_register_29') %> <b class="color_p"><%= __('member_register_30') %></b>
                                  </span>
                              </p>
                               <p>
                                  <span><%= __('member_register_31') %></span>
                                  <span>
                                      <b class="color_p bold"><%= __('member_register_32') %></b><br>
                                      <b class="color_o"><%= __('member_register_33') %></b>
                                   </span>
                              </p>
                          </div>
                      </div>
                      <div class="cautions_box" style="width: 100%">
                          <p class="title"><%= __('member_register_34') %></p>
                          <p><span class="bold"><%= __('member_register_35') %></span> <%= __('member_register_36') %> <br>
                              <span class="bold"><%= __('member_register_37') %></span> <%= __('member_register_38') %> <br>
                              <%= __('member_register_39') %> <span class="color_p"><%= __('member_register_40') %></span></p>
                      </div>
                  </div>
                    <div class="btn_group">
                        <button class="btn_login" id="btnSubmit"><%= __('member_register_41') %></button>
                    </div>
                </div>
            </div>
            <input type="hidden" name="url" value="<%= url %>">
        </form>
    </section>
    <footer>
        <% include ../common/footers %>
    </footer>
</body>
    <script>
    $('#btnSubmit').click(function(event){
      $(this).attr('disabled', true);
      const chkContract = $('#term');
      const mail = $('#inputEmail');
      const pass = $('#password');
      const passCheck = $('#password-check');
      const match = $('#match');
  
      if (chkContract.is(":checked") == false) {
        alert('Please agree to the terms of service');
        chkContract.focus();
        $(this).attr('disabled', false);
        return false;
      }
      if (!validateMail(mail.val())) {
        alert('do not match email');
        $('#emailText').text('do not match email');
        $(this).attr('disabled', false);
        return false;
      } else {
        $('#emailText').text('match email');
      }
      if (pass.val() == '') {
        alert('password required');
        $(this).attr('disabled', false);
        return false;
      }
      if (passCheck.val() == '') {
        alert('password check required');
        $(this).attr('disabled', false);
        return false;
      }
      if (!validateText(pass.val(), passCheck.val())) {
        alert('password not match');
        $(this).attr('disabled', false);
        return false;
      }
      $('#submit-form').submit();
    });
  
    $('#agreeContract').click(function(event) {
      $('#checkContract').attr("checked", true);
    });
  
    $('#password-check').keyup(function (event) {
      var match = $('#match');
      var pass = $('#password');
      var confirm = $('#password-check');
      if (pass.val() == confirm.val()) {
        match.css("color", 'blue');
        match.text('Passwords Match!');;
      } else {
        match.css("color", 'red');
        match.text('Passwords do not match');
      }
    });
  </script>
  <script src="/static/javascripts/validate.js"></script>
</html>